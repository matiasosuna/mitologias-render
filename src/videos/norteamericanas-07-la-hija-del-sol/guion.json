      "frases": [
        {
          "es": "La última vez, la pequeña Araña de Agua trajo el fuego al mundo.",
          "en": "Last time, the little Water Spider brought fire to the world."
        },
        {
          "es": "Esta historia también es cherokee. Trata del Sol, de la Luna y de la gente de la tierra.",
          "en": "This story is also Cherokee. It is about the Sun, the Moon, and the people of the earth."
        },
        {
          "es": "En esta historia cherokee, el Sol es una mujer, y la Luna es su hermano.",
          "en": "In this Cherokee story, the Sun is a woman, and the Moon is her brother."
        }
