      "frases": [
        {
          "es": "Le gustó tanto que se olvidó de su pena, y sonrió.",
          "en": "She was so pleased, she forgot her grief, and she smiled."
        },
        {
          "es": "¿Alguna vez una canción te alegró cuando estabas triste? Cuéntanos en los comentarios.",
          "en": "Has a song ever cheered you up when you were sad? Tell us in the comments."
        },
        {
          "es": "La próxima vez viajamos al norte, a los Grandes Lagos, donde un gran diluvio cubre el mundo.",
          "en": "Next time, we travel north to the Great Lakes, where a great flood covers the world."
        },
        {
          "es": "Es Nanabozho y el gran diluvio.",
          "en": "It is Nanabozho and the Great Flood."
        }
