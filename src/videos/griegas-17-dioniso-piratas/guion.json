      },
      "frases": [
        {
          "es": "Los piratas saltaron a la orilla y lo agarraron.",
          "en": "The pirates jumped onto the shore and grabbed him."
        },
        {
          "es": "Lo arrastraron hasta su barco, riéndose. Ya soñaban con el oro.",
          "en": "They dragged him onto their ship, laughing. They were already dreaming of gold."
        },
        {
          "es": "Le ataron las manos y los pies con cuerdas fuertes.",
          "en": "They tied his hands and feet with strong ropes."
        },
        {
          "es": "Pero las cuerdas no lo sujetaban. Se soltaban solas y caían a la cubierta.",
          "en": "But the ropes would not hold him. They slipped off and fell to the deck."
        },
        {
          "es": "Y Dioniso se quedó sentado, sonriendo con sus ojos oscuros.",
          "en": "And Dionysus just sat there, smiling with his dark eyes."
        }
      ],
