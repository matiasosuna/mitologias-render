      "frases": [
        {
          "es": "El león saltó sobre el capitán con un rugido terrible.",
          "en": "The lion leaped at the captain with a terrible roar."
        },
        {
          "es": "El capitán y sus hombres gritaron y se tiraron al mar, uno tras otro.",
          "en": "The captain and his men screamed, and jumped into the sea, one after another."
        },
        {
          "es": "Pero al caer al agua, sus cuerpos empezaron a cambiar.",
          "en": "But as they hit the water, their bodies began to change."
        },
        {
          "es": "Sus brazos se volvieron aletas, sus espaldas se curvaron y les crecieron colas.",
          "en": "Their arms became fins, their backs curved, and they grew tails."
        },
        {
          "es": "Se habían convertido en delfines. ¿Crees que se lo merecían?",
          "en": "They had become dolphins. Do you think they deserved it?"
        }
