        ]
      },
      "frases": [
        {
          "es": "El anzuelo bajó y bajó, mientras Māui recitaba un karakia.",
          "en": "Down, down went the hook, while Māui chanted a karakia."
        },
        {
          "es": "En el fondo del mar, se enganchó en algo.",
          "en": "Deep at the bottom of the sea, it caught on something."
        },
        {
          "es": "Había enganchado el techo de una casa: la casa de Tonganui, nieto de Tangaroa, el dios del mar.",
          "en": "It had hooked the roof of a house: the house of Tonganui, grandson of Tangaroa, the god of the sea."
        },
        {
          "es": "Algo muy pesado colgaba del otro extremo de su sedal.",
          "en": "Something very heavy hung on the end of his line."
        },
        {
          "es": "Māui tiró y tiró. La canoa se inclinó y el mar hizo espuma.",
          "en": "Māui pulled, and pulled. The canoe tipped, and the sea foamed."
        }
      ],
