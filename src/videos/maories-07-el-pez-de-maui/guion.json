      "frases": [
        {
          "es": "Así que esa noche, antes del amanecer, Māui bajó a la playa sin hacer ruido.",
          "en": "So that night, before dawn, Māui crept down to the beach."
        },
        {
          "es": "Se metió en el waka de sus hermanos, su canoa, y se escondió bajo el piso.",
          "en": "He climbed into his brothers' waka, their canoe, and hid beneath the floorboards."
        },
        {
          "es": "Se quedó quieto, sin hacer ni un ruido.",
          "en": "He lay very still, and kept quiet."
        },
        {
          "es": "Con la primera luz, los hermanos empujaron la canoa al mar, sin saber que él estaba ahí.",
          "en": "At first light, the brothers pushed off to sea, with no idea that he was there."
        }
      ],
