      },
      "frases": [
        {
          "es": "Entonces Māui sacó su anzuelo. Estaba hecho con la quijada mágica de su abuela.",
          "en": "Then Māui brought out his hook. It was made from his grandmother's magic jawbone."
        },
        {
          "es": "Brillaba con trocitos de pāua, una concha de color azul verdoso.",
          "en": "It shone with pieces of pāua, a bright blue-green shell."
        },
        {
          "es": "«Denme carnada», dijo Māui. Pero sus hermanos se negaron.",
          "en": "'Give me some bait,' said Māui. But his brothers refused."
        },
        {
          "es": "Entonces Māui se dio un golpe en la nariz con el puño y untó el anzuelo con su propia sangre.",
          "en": "So Māui struck his own nose with his fist, and smeared the hook with his own blood."
        },
        {
          "es": "Después lo dejó caer al mar.",
          "en": "Then he dropped it into the sea."
        }
      ],
