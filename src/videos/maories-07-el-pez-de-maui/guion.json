      },
      "frases": [
        {
          "es": "Así que los hermanos pescaron, y pronto la canoa se llenó de peces.",
          "en": "So the brothers fished, and soon the canoe was full of fish."
        },
        {
          "es": "«Ahora volvamos a casa», dijeron.",
          "en": "'Now let us go home,' they said."
        },
        {
          "es": "«Esperen», dijo Māui. «Déjenme tirar mi anzuelo. Vamos más lejos.»",
          "en": "'Wait,' said Māui. 'Let me throw my hook. Let us go farther out.'"
        },
        {
          "es": "Y siguieron remando, hasta quedar en medio del mar abierto.",
          "en": "So they paddled on, until they were far out on the open sea."
        }
      ],
