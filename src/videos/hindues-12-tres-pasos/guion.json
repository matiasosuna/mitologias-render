      "frases": [
        {
          "es": "Su maestro era Shukra, un sabio poderoso. Con su ayuda, Bali se volvió más fuerte que nunca.",
          "en": "His teacher was Shukra, a powerful sage. With his help, Bali grew stronger than ever."
        },
        {
          "es": "Atacó el cielo, y ni Indra ni los dioses pudieron detenerlo.",
          "en": "He attacked heaven, and neither Indra nor the gods could stop him."
        },
        {
          "es": "Bali se convirtió en rey de los tres mundos: la tierra, el cielo y el mundo de abajo.",
          "en": "Bali became king of the three worlds: the earth, the heavens, and the world below."
        },
        {
          "es": "Los dioses tuvieron que dejar su hogar y esconderse.",
          "en": "The gods had to leave their home and hide."
        }
