      "frases": [
        {
          "es": "\"¿Dónde pongo mi tercer paso?\", preguntó Vishnu.",
          "en": "\"Where shall I put my third step?\" asked Vishnu."
        },
        {
          "es": "Bali se inclinó. \"Ponlo sobre mi cabeza\", dijo. \"Así cumpliré mi promesa\".",
          "en": "Bali bowed low. \"Put it on my head,\" he said. \"Then I will have kept my promise.\""
        },
        {
          "es": "Y Vishnu puso su pie sobre la cabeza de Bali.",
          "en": "And Vishnu placed his foot on Bali's head."
        },
        {
          "es": "Bali lo había perdido todo, pero había cumplido su palabra.",
          "en": "Bali had lost everything, but he had kept his word."
        },
        {
          "es": "¿Tú habrías cumplido tu promesa, como Bali, o habrías escuchado a Shukra?",
          "en": "Would you have kept your promise like Bali, or listened to Shukra?"
        }
