      },
      "frases": [
        {
          "es": "Aditi, la madre de los dioses, sufría al ver a sus hijos sin hogar.",
          "en": "Aditi, the mother of the gods, was heartbroken to see her sons without a home."
        },
        {
          "es": "Su esposo, el sabio Kashyapa, le enseñó un voto especial de oración y ayuno.",
          "en": "Her husband, the sage Kashyapa, taught her a special vow of prayer and fasting."
        },
        {
          "es": "El Bhagavata Purana cuenta que rezó a Vishnu durante doce días, y Vishnu se le apareció.",
          "en": "The Bhagavata Purana says she prayed to Vishnu for twelve days, and Vishnu appeared before her."
        },
        {
          "es": "\"Naceré como tu hijo\", le prometió.",
          "en": "\"I will be born as your son,\" he promised."
        }
      ],
