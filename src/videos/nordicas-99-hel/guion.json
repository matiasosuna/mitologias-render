      "frases": [
        {
          "es": "Entonces Odín, el jefe de los dioses, mandó que le trajeran a los tres niños.",
          "en": "So Odin, the chief of the gods, had the three children brought to him."
        },
        {
          "es": "A la serpiente la arrojó al mar. Al lobo lo dejó en Asgard, donde podía vigilarlo.",
          "en": "He threw the serpent into the sea. The wolf he kept in Asgard, where he could watch it."
        },
        {
          "es": "Y a la niña, Hel, la arrojó a Niflheim, el mundo de la niebla y el hielo.",
          "en": "And the girl, Hel, he threw down into Niflheim, the world of mist and ice."
        }
