      "frases": [
        {
          "es": "Por fin Hermod llegó a la puerta de Hel. Estaba bien cerrada.",
          "en": "At last, Hermod came to the gate of Hel. It was shut tight."
        },
        {
          "es": "Algunos poemas dicen que un gran perro cuidaba ese camino, con sangre en el pecho.",
          "en": "Some poems say a great hound guarded that road, with blood on its chest."
        },
        {
          "es": "Hermod bajó, apretó la montura, volvió a subir y espoleó a su caballo.",
          "en": "Hermod got off, tightened the saddle, climbed back on, and spurred his horse."
        },
        {
          "es": "Sleipnir saltó tan alto que pasó por encima de la puerta sin tocarla.",
          "en": "Sleipnir jumped so high that he flew over the gate, and never touched it."
        },
        {
          "es": "Dentro del salón, Hermod vio a su hermano Baldr, sentado en el lugar de honor.",
          "en": "Inside the hall, Hermod saw his brother Baldr, sitting in the seat of honor."
        }
      ],
