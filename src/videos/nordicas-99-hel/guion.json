      },
      "frases": [
        {
          "es": "Su salón era enorme, con muros altísimos y grandes portones.",
          "en": "Her hall was huge, with very high walls and great gates."
        },
        {
          "es": "Todo allí tenía un nombre aterrador. Su plato se llamaba Hambre. Su cuchillo, Hambruna.",
          "en": "Everything in it had a frightening name. Her plate was called Hunger. Her knife was called Famine."
        },
        {
          "es": "Sus dos sirvientes eran tan lentos que casi no parecían moverse.",
          "en": "Her two servants were so slow that they barely seemed to move."
        },
        {
          "es": "El umbral de la puerta se llamaba Caída al Peligro. Y su cama se llamaba Lecho de Enfermo.",
          "en": "The doorstep was called Falling to Danger. And her bed was called Sickbed."
        }
      ],
