      "frases": [
        {
          "es": "Al principio, solo había Nun, un océano oscuro, quieto y sin fin.",
          "en": "In the beginning, there was only Nun, a dark ocean, still and endless."
        },
        {
          "es": "No había cielo ni tierra. No había luz, ni nada vivo.",
          "en": "There was no sky and no earth. There was no light, and nothing alive."
        },
        {
          "es": "En esa agua oscura estaba el primer dios, Atum. Estaba completamente solo.",
          "en": "In that dark water was the first god, Atum. He was all alone."
        }
      ],
