      "frases": [
        {
          "es": "Después Shu y Tefnut se alejaron por el océano oscuro.",
          "en": "Then Shu and Tefnut drifted away into the dark ocean."
        },
        {
          "es": "Se fueron tan lejos que Atum los perdió.",
          "en": "They went so far that Atum lost them."
        },
        {
          "es": "Entonces Atum mandó a su Ojo a buscarlos.",
          "en": "So Atum sent out his Eye to look for them."
        },
        {
          "es": "Se llamaba el Ojo de Ra, porque Atum también era el sol, al que al amanecer llamaban Ra.",
          "en": "It was called the Eye of Ra, because Atum was also the sun, called Ra at dawn."
        },
        {
          "es": "Ese Ojo podía moverse y actuar solo, como un ser vivo.",
          "en": "This Eye could move and act on its own, like a living being."
        }
