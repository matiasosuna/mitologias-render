      "frases": [
        {
          "es": "Antes de las pirámides, antes de los faraones, antes incluso del Nilo, solo había agua.",
          "en": "Before the pyramids, before the pharaohs, before even the Nile, there was only water."
        },
        {
          "es": "Un océano oscuro, quieto y sin fin, que los egipcios llamaban Nun.",
          "en": "A dark, still, endless ocean that the Egyptians called Nun."
        },
        {
          "es": "No había cielo ni tierra. No había luz. No había nada vivo.",
          "en": "There was no sky and no earth. There was no light. There was nothing alive."
        },
        {
          "es": "Y sin embargo, en el fondo de esas aguas, algo estaba esperando.",
          "en": "And yet, deep in those waters, something was waiting."
        }
      ],
