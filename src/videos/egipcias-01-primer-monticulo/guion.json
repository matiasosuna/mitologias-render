      "frases": [
        {
          "es": "Shu y Tefnut tuvieron dos hijos: Geb, la tierra, y Nut, el cielo.",
          "en": "Shu and Tefnut had two children: Geb, the earth, and Nut, the sky."
        },
        {
          "es": "Y Geb y Nut se abrazaban tan fuerte que entre ellos no cabía nada. Ni el aire. Ni la luz.",
          "en": "And Geb and Nut held each other so tightly that nothing fit between them. Not air. Not light."
        },
        {
          "es": "Alguien iba a tener que separarlos. Esa es la historia del próximo episodio.",
          "en": "Someone would have to pull them apart. That is the story of the next episode."
        }
