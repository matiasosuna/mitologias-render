      "frases": [
        {
          "es": "Pero Shu y Tefnut se alejaron a explorar las aguas oscuras.",
          "en": "But Shu and Tefnut wandered off to explore the dark waters."
        },
        {
          "es": "Se fueron tan lejos que se perdieron en el Nun.",
          "en": "They went so far that they got lost in the Nun."
        },
        {
          "es": "Atum, desesperado, se arrancó un ojo y lo mandó a buscarlos.",
          "en": "Atum, desperate, sent out his own Eye to find them."
        },
        {
          "es": "Ese ojo tenía vida propia. Los egipcios lo llamaban el Ojo de Ra.",
          "en": "That Eye had a life of its own. The Egyptians called it the Eye of Ra."
        }
