      "frases": [
        {
          "es": "Entonces Atum decidió crear compañía.",
          "en": "So Atum decided to create company."
        },
        {
          "es": "Soltó su aliento, y de ese aliento nació Shu, el dios del aire.",
          "en": "He breathed out, and from that breath came Shu, the god of air."
        },
        {
          "es": "Y escupió, y de esa humedad nació Tefnut, la diosa con cabeza de leona.",
          "en": "And he spat, and from that moisture came Tefnut, the lion-headed goddess."
        },
        {
          "es": "Ellos fueron la primera pareja de dioses: el aire y la humedad.",
          "en": "They were the first pair of gods: air and moisture."
        }
      ],
