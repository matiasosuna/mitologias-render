      },
      "frases": [
        {
          "es": "Sobre esa colina apareció un dios que se creó a sí mismo: Atum, el que está completo.",
          "en": "On that mound appeared a god who created himself: Atum, the complete one."
        },
        {
          "es": "Atum era el primero. Antes de él no había padre ni madre.",
          "en": "Atum was the first. Before him there was no father and no mother."
        },
        {
          "es": "Pero estaba solo, en medio de un océano infinito.",
          "en": "But he was alone, in the middle of an endless ocean."
        }
      ],
      "elementos": [
