        ]
      },
      "frases": [
        {
          "es": "Orfeo bajó por el camino oscuro, tocando su lira mientras avanzaba.",
          "en": "Orpheus walked down the dark road, playing his lyre as he went."
        },
        {
          "es": "Las sombras se juntaron a escucharlo. Y Caronte lo llevó al otro lado, aunque estaba vivo.",
          "en": "The shades gathered around to listen. And Charon carried him across, even though he was alive."
        },
        {
          "es": "Cerbero oyó la música. Sus tres bocas se quedaron abiertas, y no ladró.",
          "en": "Cerberus heard the music. His three mouths hung open, and he did not bark."
        },
        {
          "es": "Ovidio dice que hasta los condenados dejaron su castigo para escuchar. Por un momento, todo el inframundo calló.",
          "en": "Ovid says even the punished stopped their work to listen. For one moment, the whole underworld was quiet."
        }
      ],
