      "frases": [
        {
          "es": "Esta noche es especial. Dicen que es la noche en que los muertos se acercan.",
          "en": "Tonight is a special night. People say it is the night when the dead come close."
        },
        {
          "es": "Por eso, en este especial, visitamos a los señores de los muertos, los reyes del mundo de abajo.",
          "en": "So in this special, we visit the lords of the dead, the kings of the world below."
        },
        {
          "es": "Empezamos en Grecia, con Hades, el más oscuro de los dioses.",
          "en": "We begin in Greece, with Hades, the darkest of the gods."
        },
        {
          "es": "Hades era hermano de Zeus y de Poseidón. Después de una gran guerra, los tres se sortearon el mundo.",
          "en": "Hades was a brother of Zeus and Poseidon. After a great war, the three brothers drew lots to share the world."
        },
        {
          "es": "Zeus se quedó con el cielo. Poseidón, con el mar. Y Hades, con el mundo oscuro bajo la tierra.",
          "en": "Zeus got the sky. Poseidon got the sea. And Hades got the dark world under the earth."
        }
      ],
