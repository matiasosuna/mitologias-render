        },
        {
          "es": "Los asuras, los rivales de los dioses, se quedaron con el cielo.",
          "en": "The asuras, the rivals of the gods, took over heaven."
        },
        {
          "es": "Entonces Vishnu, el protector del mundo, les dio a los dioses un plan extraño.",
          "en": "Then Vishnu, the protector of the world, gave the gods a strange plan."
        },
        {
          "es": "Batan el océano, les dijo, y háganlo junto con sus enemigos.",
          "en": "Churn the ocean, he said, and do it together with your enemies."
        }
