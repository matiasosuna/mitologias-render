      "frases": [
        {
          "es": "Así que Indra, el rey de los dioses, fue a ver a Bali, el rey de los asuras.",
          "en": "So Indra, the king of the gods, went to see Bali, the king of the asuras."
        },
        {
          "es": "El Bhagavata Purana dice que los guerreros de Bali querían atacar, pero Bali los detuvo.",
          "en": "The Bhagavata Purana says Bali's warriors wanted to attack, but Bali stopped them."
        },
        {
          "es": "Indra le propuso un trato: batir juntos el océano y repartir lo que saliera.",
          "en": "Indra offered a deal: let's churn the ocean together, and share whatever comes out."
        },
        {
          "es": "El premio más grande sería el amrita, el néctar que te hace vivir para siempre.",
          "en": "The biggest prize would be amrita, the nectar that lets you live forever."
        },
        {
          "es": "Bali aceptó, y los viejos enemigos hicieron una tregua.",
          "en": "Bali agreed, and the old enemies made a truce."
        }
      ],
