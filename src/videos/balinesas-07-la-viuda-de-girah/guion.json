      "frases": [
        {
          "es": "Todos sabían que su madre practicaba magia oscura.",
          "en": "Everyone knew that her mother practiced dark magic."
        },
        {
          "es": "La gente murmuraba de ella en el mercado y se apartaba cuando pasaba.",
          "en": "People whispered about her at the market, and stepped aside when she passed."
        },
        {
          "es": "Algunos hasta decían que de noche podía tomar la forma de un animal, o de una llama que flota.",
          "en": "Some even said that at night she could take the shape of an animal, or of a floating flame."
        },
        {
          "es": "Ninguna familia quería a Calon Arang como suegra.",
          "en": "No family wanted Calon Arang as a mother-in-law."
        },
        {
          "es": "Y Calon Arang lo tomó como un insulto terrible.",
          "en": "And Calon Arang took this as a terrible insult."
        }
      ],
