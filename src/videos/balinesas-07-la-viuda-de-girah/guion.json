      "frases": [
        {
          "es": "En la aldea de Girah vivía una viuda llamada Calon Arang.",
          "en": "In the village of Girah lived a widow named Calon Arang."
        },
        {
          "es": "En las viejas lenguas de Java y Bali, a una viuda se le dice rangda. Recuerda esa palabra.",
          "en": "In the old languages of Java and Bali, a widow is called a rangda. Remember that word."
        },
        {
          "es": "Tenía una sola hija, Ratna Manggali, que era buena y hermosa.",
          "en": "She had one daughter, Ratna Manggali, who was kind and beautiful."
        },
        {
          "es": "Pero ningún hombre de toda la tierra se animaba a casarse con ella.",
          "en": "But no man in the whole land dared to marry her."
        },
        {
          "es": "Ratna Manggali no había hecho nada malo. Aun así, pasaban los años y seguía sola.",
          "en": "Ratna Manggali had done nothing wrong. Still, the years went by, and she stayed alone."
        }
      ],
