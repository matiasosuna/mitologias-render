      "frases": [
        {
          "es": "El Paoa no era un palo común. Servía para probar la tierra.",
          "en": "The Paoa was no ordinary stick. It was used to test the ground."
        },
        {
          "es": "Pele lo clavaba en el suelo, y el palo le decía si ese lugar servía para su fuego.",
          "en": "Pele pushed it into the ground, and the stick told her if the place was right for her fire."
        },
        {
          "es": "La tierra tenía que ser fuerte, para que el agua del mar no pudiera entrar.",
          "en": "The land had to be strong, so that sea water could not get in."
        },
        {
          "es": "Y el Paoa también era una pala, para cavar el pozo del fuego.",
          "en": "And the Paoa was also a spade, to dig the fire pit."
        },
        {
          "es": "En Nihoa, el palo dijo que no.",
          "en": "On Nihoa, the stick said no."
        }
