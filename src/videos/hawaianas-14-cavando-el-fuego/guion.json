      "frases": [
        {
          "es": "En el camino por Oʻahu, Pele había probado muchos lugares.",
          "en": "Along the way across Oʻahu, Pele had tried many places."
        },
        {
          "es": "Cavó en Āliapaʻakai, pero el pozo se llenó de agua salada. Hoy lo llaman Salt Lake, el lago de sal.",
          "en": "She dug at Āliapaʻakai, but the pit filled with salt water. Today it is called Salt Lake."
        },
        {
          "es": "Probó en Puowaina, la colina que hoy llaman Punchbowl.",
          "en": "She tried at Puowaina, the hill that people today call Punchbowl."
        },
        {
          "es": "Probó en Lēʻahi, que hoy se llama Diamond Head. Allí lanzó mucha roca de fuego.",
          "en": "She tried at Lēʻahi, which today is called Diamond Head. There she threw up a great deal of fire-rock."
        },
        {
          "es": "Pero siempre, al cavar hondo, encontraba agua. Y el agua mataba el fuego.",
          "en": "But every time she dug deep, she found water. And the water killed the fire."
        }
      ],
