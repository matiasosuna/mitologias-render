      "frases": [
        {
          "es": "La última vez, Pele huyó de Kahiki en una gran canoa, con su hermanita dentro de un huevo.",
          "en": "Last time, Pele fled Kahiki in a great canoe, with her baby sister inside an egg."
        },
        {
          "es": "Navegaron muchos días sin ver tierra.",
          "en": "They sailed for many days without seeing land."
        },
        {
          "es": "Hasta que, una mañana, apareció una roca en el mar.",
          "en": "Until one morning, a rock appeared in the sea."
        },
        {
          "es": "Era Nihoa, una isla pequeña y alta, en el extremo de la cadena de Hawaiʻi.",
          "en": "It was Nihoa, a small, steep island at the far end of the Hawaiian chain."
        },
        {
          "es": "Pele bajó a tierra con su palo mágico, Paoa.",
          "en": "Pele went ashore with her magic stick, Paoa."
