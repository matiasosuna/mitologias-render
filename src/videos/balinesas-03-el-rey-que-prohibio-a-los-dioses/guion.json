        "zoom": [
          1,
          1.05
        ]
      },
      "frases": [
        {
          "es": "Mayadenawa no quería que nadie fuera más grande que él.",
          "en": "Mayadenawa did not want anyone to be greater than him."
        },
        {
          "es": "Entonces dio una orden: no más rezos a los dioses. No más ofrendas en los templos.",
          "en": "So he gave an order: no more prayers to the gods. No more offerings at the temples."
        },
        {
          "es": "Ahora yo soy su dios, dijo. Tráiganme sus regalos a mí.",
          "en": "I am your god now, he said. Bring your gifts to me."
        },
        {
          "es": "Sus soldados echaron a la gente, y la maleza empezó a crecer entre las piedras del templo.",
          "en": "His soldiers chased the people out, and weeds began to grow between the temple stones."
        }
      ],
