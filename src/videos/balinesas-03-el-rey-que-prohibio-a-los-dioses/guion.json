      "frases": [
        {
          "es": "Cuando cayó la noche, Mayadenawa vio que estaba perdiendo.",
          "en": "When night fell, Mayadenawa saw that he was losing."
        },
        {
          "es": "Entonces se escabulló en la oscuridad, con unos pocos seguidores fieles.",
          "en": "So he slipped away into the darkness, with only a few loyal followers."
        },
