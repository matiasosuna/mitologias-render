      },
      "frases": [
        {
          "es": "Se llamaba Mayadenawa. Una vieja crónica balinesa en hojas de palma, el Usana Bali, cuenta su historia.",
          "en": "His name was Mayadenawa. An old Balinese palm-leaf chronicle, the Usana Bali, tells his story."
        },
        {
          "es": "Era un daitya, un demonio poderoso, y un maestro de la magia.",
          "en": "He was a daitya, a mighty demon, and a master of magic."
        },
        {
          "es": "Podía cambiar de forma cuando quisiera: en un animal, en un ave, hasta en una piedra.",
          "en": "He could change his shape whenever he wished: into an animal, a bird, even a stone."
        },
        {
          "es": "Gobernaba la isla desde su palacio en Bedahulu, en el centro de Bali.",
          "en": "He ruled the island from his palace at Bedahulu, in the middle of Bali."
        },
        {
          "es": "Bedahulu todavía es una aldea, cerca del pueblo de Ubud.",
          "en": "Bedahulu is still a village today, close to the town of Ubud."
        }
      ],
