      "frases": [
        {
          "es": "La última vez, el cielo se cayó, y los dioses lo levantaron otra vez.",
          "en": "Last time, the sky fell, and the gods lifted it back up."
        },
        {
          "es": "Pero el mundo estaba vacío. La gente de las épocas anteriores ya no estaba.",
          "en": "But the world was empty. The people of the earlier ages were gone."
        },
        {
          "es": "Cuatro soles se habían terminado, y con ellos, toda la gente de antes.",
          "en": "Four suns had ended, and with them, all the people from before."
        },
        {
          "es": "Los dioses se preguntaron: \"¿Quién va a vivir en la tierra?\"",
          "en": "The gods asked each other: \"Who will live on the earth?\""
        }
      ],
