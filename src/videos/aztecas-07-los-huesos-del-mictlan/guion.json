      "frases": [
        {
          "es": "El Señor de los Muertos le puso una prueba: \"Toca mi caracol, y dale cuatro vueltas a mi círculo de jade.\"",
          "en": "The Lord of the Dead set him a test: \"Blow my conch shell, and walk four times around my circle of jade.\""
        },
        {
          "es": "Pero era una trampa: el caracol no tenía agujeros. No podía sonar.",
          "en": "But it was a trick: the shell had no holes. It could not make a sound."
        },
        {
          "es": "Quetzalcóatl sopló y sopló, y no salió ni un ruido.",
          "en": "Quetzalcoatl blew and blew, and not a sound came out."
        }
      ],
