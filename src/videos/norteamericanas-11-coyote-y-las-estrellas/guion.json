      "frases": [
        {
          "es": "Coyote tomó su arco y cinco aljabas llenas de flechas.",
          "en": "Coyote took his bow, and five quivers full of arrows."
        },
        {
          "es": "Disparó la primera flecha al cielo, y ahí quedó clavada.",
          "en": "He shot the first arrow into the sky, and it stuck there."
        },
        {
          "es": "Disparó otra, y se clavó en la punta de la primera. Y otra, y otra.",
          "en": "He shot another, and it stuck in the end of the first. Then another, and another."
        },
        {
          "es": "Pronto hubo una larga escalera de flechas, desde el cielo hasta el suelo.",
          "en": "Soon there was a long ladder of arrows, reaching from the sky all the way down to the ground."
        }
      ],
