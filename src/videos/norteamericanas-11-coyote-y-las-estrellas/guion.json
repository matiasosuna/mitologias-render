      "frases": [
        {
          "es": "En esta historia, Coyote vivía con cinco hermanos Lobo.",
          "en": "In this story, Coyote lived with five Wolf brothers."
        },
        {
          "es": "Cada día salían a cazar, y compartían la carne con él.",
          "en": "Every day they went hunting, and they shared their meat with him."
        },
        {
          "es": "Los Lobos tenían un perrito. El hermano mayor siempre lo llevaba.",
          "en": "The Wolves had a little dog. The oldest brother always carried it."
        },
        {
          "es": "En las historias wasco, Coyote es un embaucador: astuto, tonto y siempre lleno de planes.",
          "en": "In Wasco stories, Coyote is a trickster: clever, foolish, and always full of plans."
        }
