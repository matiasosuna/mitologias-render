      "frases": [
        {
          "es": "Después Coyote cortó en pedazos el gran cuerpo del monstruo.",
          "en": "Then Coyote cut up the monster's great body."
        },
        {
          "es": "Tiró los pedazos lejos por toda la tierra: hacia donde sale el sol y donde se pone, a las tierras cálidas y a las frías.",
          "en": "He threw the pieces far across the land: toward the sunrise and the sunset, the warm lands and the cold lands."
        },
        {
