      "frases": [
        {
          "es": "Un día, Māui dijo: «Yo le llevaré la comida».",
          "en": "One day, Māui said, 'I will take her food to her.'"
        },
        {
          "es": "Pero nunca se la dio. Día tras día, se la quedaba.",
          "en": "But he never gave it to her. Day after day, he kept it."
        },
        {
          "es": "La anciana empezó a tener hambre, y a sospechar.",
          "en": "The old woman grew hungry, and suspicious."
        },
        {
          "es": "Cuando Māui se acercó, olfateó el aire. Olía a un desconocido.",
          "en": "When Māui came near, she sniffed the air. She smelled a stranger."
        },
        {
          "es": "Su panza empezó a hincharse. ¡Estaba lista para comérselo!",
          "en": "Her belly began to swell. She was ready to eat him up!"
        }
      ],
