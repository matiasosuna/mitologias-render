      "frases": [
        {
          "es": "En aquellos tiempos, el sol cruzaba el cielo a toda carrera.",
          "en": "In those days, the sun raced across the sky."
        },
        {
          "es": "Los días eran tan cortos que a la gente no le alcanzaba el tiempo para trabajar.",
          "en": "The days were so short that people never had enough time to work."
        },
        {
          "es": "No había tiempo para juntar comida, ni siquiera para comerla.",
          "en": "There was no time to gather food, or even to eat it."
        },
        {
          "es": "Māui vio al sol caer del cielo otra vez, y se enojó.",
          "en": "Māui watched the sun drop out of the sky once again, and he grew angry."
        }
