      "frases": [
        {
          "es": "Salieron hacia el este, hacia donde sale el sol.",
          "en": "They set out toward the east, toward the place where the sun comes up."
        },
        {
          "es": "Viajaban solo de noche, para que el sol no los viera venir.",
          "en": "They traveled only at night, so the sun would not see them coming."
        },
        {
          "es": "De día se escondían y dormían.",
          "en": "By day, they hid and slept."
        },
        {
          "es": "Noche tras noche siguieron andando, cargando sus sogas.",
          "en": "Night after night they kept going, carrying their ropes."
        },
        {
          "es": "Al fin llegaron al borde del mundo, al pozo de donde sale el sol.",
          "en": "At last they reached the edge of the world, and the pit where the sun climbs out."
        }
      ],
