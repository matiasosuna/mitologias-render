      "frases": [
        {
          "es": "A la mañana, los soldados de Indra se despertaron con sed.",
          "en": "In the morning, Indra's soldiers woke up thirsty."
        },
        {
          "es": "Bebieron del manantial nuevo y, uno a uno, se enfermaron.",
          "en": "They drank from the new spring, and one by one, they fell sick."
        },
        {
          "es": "Se les puso pálida la cara y les empezaron a temblar las manos.",
          "en": "Their faces turned pale, and their hands began to shake."
        },
        {
          "es": "Pronto todo el ejército estaba tirado en el suelo, demasiado débil para pararse.",
          "en": "Soon the whole army lay on the ground, too weak to stand."
        }
