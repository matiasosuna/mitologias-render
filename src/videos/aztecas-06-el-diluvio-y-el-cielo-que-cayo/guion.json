          1.06
        ]
      },
      "frases": [
        {
          "es": "Entonces empezó a llover. Llovió y llovió, sin parar.",
          "en": "Then it began to rain. It rained and rained, without stopping."
        },
        {
          "es": "El agua subió tanto que cubrió hasta las montañas.",
          "en": "The water rose so high that it covered even the mountains."
        },
        {
          "es": "La gente de esa época se convirtió en peces.",
          "en": "The people of that age were turned into fish."
        },
        {
          "es": "Y en medio del agua, un tronco flotaba solo.",
          "en": "And in the middle of all that water, a single log floated."
        }
      ],
