        "zoom": [
          1,
          1.05
        ]
      },
      "frases": [
        {
          "es": "Tezcatlipoca y Quetzalcóatl se convirtieron en dos árboles enormes.",
          "en": "Tezcatlipoca and Quetzalcoatl turned themselves into two enormous trees."
        },
        {
          "es": "Con los árboles y los cuatro hombres, empujaron el cielo hacia arriba, con todas sus estrellas.",
          "en": "With the trees and the four men, they pushed the sky back up, with all its stars."
        },
