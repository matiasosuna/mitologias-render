      "frases": [
        {
          "es": "Chalchiuhtlicue subió al cielo y se convirtió en el sol. Comenzó la cuarta época.",
          "en": "Chalchiuhtlicue rose into the sky and became the sun. The fourth age began."
        },
        {
          "es": "Los mexicas la llamaban Nahui Atl, Cuatro Agua: el Sol de Agua.",
          "en": "The Mexica called it Nahui Atl, Four Water: the Water Sun."
        },
        {
          "es": "Bajo su sol, los ríos corrían limpios y los lagos estaban llenos.",
          "en": "Under her sun, the rivers ran clear and the lakes were full."
        },
        {
          "es": "Según la Leyenda de los Soles, duró seiscientos setenta y seis años, igual que el primero.",
          "en": "According to the Legend of the Suns, it lasted six hundred and seventy-six years, just like the first."
        }
      ],
