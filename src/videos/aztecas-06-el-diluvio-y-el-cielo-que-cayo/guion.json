      "frases": [
        {
          "es": "Chalchiuhtlicue era la diosa del agua: de los ríos, los lagos y los manantiales.",
          "en": "Chalchiuhtlicue was the goddess of water: of rivers, lakes and springs."
        },
        {
          "es": "Su nombre quiere decir \"la de la falda de jade\". El agua clara brilla verde, como esa piedra.",
          "en": "Her name means \"She of the Jade Skirt\". Clear water shines green, like that stone."
        },
        {
          "es": "Los mexicas le pedían por los recién nacidos, en su primer baño.",
          "en": "The Mexica prayed to her for newborn babies, at their first bath."
        }
      ],
