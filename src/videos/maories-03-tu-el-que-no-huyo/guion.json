      "frases": [
        {
          "es": "Después fue tras los hijos de Tangaroa: los peces.",
          "en": "Next, he went after the children of Tangaroa: the fish."
        },
        {
          "es": "Con hojas de lino, el harakeke, tejió una red enorme.",
          "en": "From the leaves of flax, called harakeke, he wove an enormous net."
        },
        {
          "es": "La tiró al mar y la arrastró hasta la orilla, llena de peces.",
          "en": "He threw it into the sea and dragged it back to the shore, full of fish."
        },
        {
          "es": "Los hijos de Tangaroa quedaron atrapados en la arena.",
          "en": "Tangaroa's children lay trapped on the sand."
        },
        {
          "es": "Tangaroa, escondido en lo hondo, no pudo salvarlos.",
          "en": "Tangaroa, hiding in the deep, could not save them."
        }
