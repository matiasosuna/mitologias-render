      "frases": [
        {
          "es": "Después buscó a Rongo y a Haumia, que estaban escondidos en la tierra.",
          "en": "Then he searched for Rongo and Haumia, who were hiding in the earth."
        },
        {
          "es": "Encontró el kūmara por sus hojas, que asomaban del suelo.",
          "en": "He found the kūmara by its leaves, poking up out of the ground."
        },
        {
          "es": "Con un kō, un palo de cavar, los sacó y los juntó en canastas.",
          "en": "With a kō, a digging stick, he dug them up and piled them into baskets."
        },
        {
          "es": "A la raíz de helecho de Haumia la encontró de la misma manera.",
          "en": "He found Haumia's fern root in exactly the same way."
        },
        {
          "es": "Nadie podía esconderse de Tū.",
          "en": "Nobody could hide from Tū."
        }
      ],
