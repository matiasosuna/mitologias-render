      "frases": [
        {
          "es": "Ra era el dios del sol y rey de los dioses. Cada día recorría el mundo con Shu, Thoth y los demás dioses.",
          "en": "Ra was the sun god and king of the gods. Every day he travelled the world with Shu, Thoth and the other gods."
        },
        {
          "es": "Ra se había vuelto muy viejo. Tenía la boca abierta y gotas de saliva caían al suelo.",
          "en": "Ra had grown very old. His mouth hung open, and drops of spit fell to the ground."
        },
        {
          "es": "Isis lo vio. Era la más astuta de los dioses y sabía más hechizos que nadie.",
          "en": "Isis saw it. She was the cleverest of the gods, and she knew more spells than anyone."
        },
        {
          "es": "Pero Ra tenía un nombre secreto que nadie conocía, ni siquiera los otros dioses.",
          "en": "But Ra had a secret name that nobody knew, not even the other gods."
        },
        {
          "es": "Quien lo supiera tendría el poder de Ra. Isis quería ese poder.",
          "en": "Whoever knew it would hold the power of Ra. Isis wanted that power."
        }
      ],
