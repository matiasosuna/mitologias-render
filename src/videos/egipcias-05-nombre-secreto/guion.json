      "frases": [
        {
          "es": "Isis esperó a que Ra pasara y recogió la saliva que había caído al suelo.",
          "en": "Isis waited for Ra to pass and gathered the spit from the ground."
        },
        {
          "es": "La mezcló con tierra y la amasó, como un alfarero modela la arcilla.",
          "en": "She mixed it with earth and kneaded it, the way a potter shapes clay."
        },
        {
          "es": "Con esa masa moldeó una serpiente tan larga como una lanza, y con su magia le dio vida.",
          "en": "She shaped a serpent as long as a spear. With her magic she gave it life."
        },
        {
          "es": "Luego la dejó en el camino que Ra recorría cada día, y se escondió a esperar.",
          "en": "Then she laid it on the path Ra took every day, and hid to wait."
        }
      ],
