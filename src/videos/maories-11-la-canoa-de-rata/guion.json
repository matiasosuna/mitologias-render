      },
      "frases": [
        {
          "es": "La noche de luna nueva, Rātā se escondió junto al pozo, muy quieto.",
          "en": "On the night of the new moon, Rātā hid beside the pool, very still."
        },
        {
          "es": "La tierra tembló. Y de debajo de la tierra salió Matuku-tangotango.",
          "en": "The ground shook. And out of the earth climbed Matuku-tangotango."
        },
        {
          "es": "El gigante se agachó sobre el agua para lavarse.",
          "en": "The giant bent down over the water to wash."
        },
        {
          "es": "Entonces Rātā saltó de su escondite y lo agarró.",
          "en": "Then Rātā leapt out of hiding and seized him."
        },
        {
          "es": "Hubo una gran lucha y un destello en la oscuridad. A Matuku-tangotango no se lo vio nunca más.",
          "en": "There was a great struggle, and a flash in the dark. Matuku-tangotango was never seen again."
        }
      ],
