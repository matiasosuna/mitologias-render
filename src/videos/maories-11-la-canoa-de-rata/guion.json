      "frases": [
        {
          "es": "A Wahieroa lo mató Matuku-tangotango, un ser gigante y terrible que vivía bajo la tierra.",
          "en": "Wahieroa was killed by Matuku-tangotango, a terrible giant being who lived under the ground."
        },
        {
          "es": "Wahieroa cayó, y ya no se levantó.",
          "en": "Wahieroa fell, and he did not rise again."
        },
        {
          "es": "Rātā creció sin su padre.",
          "en": "Rātā grew up without his father."
        },
        {
          "es": "Pero nunca lo olvidó. Cuando se hizo hombre, quiso justicia.",
          "en": "But he never forgot. When he became a man, he wanted justice."
        }
      ],
