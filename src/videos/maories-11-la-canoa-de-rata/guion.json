        "zoom": [
          1,
          1.05
        ]
      },
      "frases": [
        {
          "es": "A la mañana siguiente, Rātā volvió para darle forma a su canoa.",
          "en": "The next morning, Rātā came back to shape his canoe."
        },
        {
          "es": "Pero el árbol estaba otra vez de pie, entero, como si nadie lo hubiera tocado.",
          "en": "But the tree was standing again, whole, as if nobody had ever touched it."
        },
        {
          "es": "Rātā se quedó mirando. No faltaba ni una astilla.",
          "en": "Rātā stared. Not a single chip was missing."
        },
        {
          "es": "Así que lo taló por segunda vez. Y otra vez se fue a su casa.",
          "en": "So he cut it down a second time. And once again, he went home."
        }
      ],
      "elementos": [
        {
          "tipo": "totara",
