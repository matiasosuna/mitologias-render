          1.05
        ]
      },
      "frases": [
        {
          "es": "Rātā preguntó a todos dónde podía encontrar a Matuku. Por fin, alguien le contó el secreto.",
          "en": "Rātā asked everyone where he could find Matuku. At last, someone told him the secret."
        },
        {
          "es": "«Matuku vive bajo la tierra. Solo sale cuando hay luna nueva.»",
          "en": "'Matuku lives under the earth. He only comes out when the moon is new.'"
        },
        {
          "es": "«Entonces va a un pozo de agua, a lavarse y a mirarse en el agua.»",
          "en": "'Then he goes to a pool of water, to wash himself and look at his face.'"
        },
        {
          "es": "Rātā armó un plan: estaría esperándolo allí, en la oscuridad.",
          "en": "Rātā made a plan. He would be waiting there, in the dark."
        },
        {
          "es": "Así que Rātā esperó a la luna nueva.",
          "en": "So Rātā waited for the new moon."
        }
      ],
