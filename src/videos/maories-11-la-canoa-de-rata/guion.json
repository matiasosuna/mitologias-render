      "frases": [
        {
          "es": "Rātā saltó de su escondite. «¿Por qué deshacen mi trabajo?», gritó.",
          "en": "Rātā jumped out. 'Why are you undoing my work?' he shouted."
        },
        {
          "es": "El bosque le respondió: «Talaste a un hijo de Tāne, y nunca pediste permiso».",
          "en": "The forest answered him: 'You cut down a child of Tāne, and you never asked permission.'"
        },
        {
          "es": "Rātā bajó la cabeza. Sintió una vergüenza muy honda.",
          "en": "Rātā lowered his head. He felt deeply ashamed."
        },
        {
          "es": "«Lo siento», dijo. «No lo pensé.»",
          "en": "'I am sorry,' he said. 'I did not think.'"
        },
        {
          "es": "¿Tú habrías discutido con el bosque, o habrías pedido perdón como Rātā?",
          "en": "Would you have argued with the forest, or said sorry like Rātā?"
        }
