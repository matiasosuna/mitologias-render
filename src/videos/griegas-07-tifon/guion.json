   "frases": [
    {
     "es": "Los Gigantes habían caído en Flegra, pero Gea, la madre Tierra, no aceptó la derrota.",
     "en": "The Giants had fallen at Phlegra, but Gaia, Mother Earth, would not accept defeat."
    },
    {
     "es": "Bajó a lo más hondo del mundo y se unió al Tártaro, el abismo oscuro que hay debajo de todo.",
     "en": "She sank to the deepest place in the world and joined Tartarus, the dark abyss beneath everything."
    },
    {
     "es": "De esa unión nació su último hijo, en una cueva de Cilicia, lejos de la mirada de los dioses.",
     "en": "From that union her last son was born, in a cave in Cilicia, far from the eyes of the gods."
    },
    {
     "es": "Lo llamaron Tifón. Y nunca existió un ser más grande ni más terrible.",
     "en": "They named him Typhon. And there had never been a being so huge or so terrible."
    }
   ],
