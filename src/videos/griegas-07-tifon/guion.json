   "frases": [
    {
     "es": "De repente, el monstruo enroscó sus serpientes alrededor de Zeus y lo atrapó.",
     "en": "Suddenly the monster coiled his serpents around Zeus and caught him."
    },
    {
     "es": "Le arrancó la hoz de las manos, y con ella le cortó los tendones de los brazos y de las piernas.",
     "en": "He tore the sickle from his hands and used it to cut the sinews from his arms and legs."
    },
    {
     "es": "El rey de los dioses quedó tirado en el suelo, sin poder moverse.",
     "en": "The king of the gods lay on the ground, unable to move."
    },
    {
     "es": "Tifón se lo llevó a la cueva Coricia, y escondió los tendones envueltos en una piel de oso.",
     "en": "Typhon carried him to the Corycian cave and hid the sinews wrapped in a bearskin."
    },
    {
     "es": "Para cuidarlos dejó a Delfine, una dragona mitad mujer y mitad serpiente.",
     "en": "To guard them he left Delphyne, a dragoness, half woman and half serpent."
    }
