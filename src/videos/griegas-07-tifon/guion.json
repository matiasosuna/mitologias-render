   "frases": [
    {
     "es": "Zeus atacó primero desde lejos, lanzando rayo tras rayo sobre las cien cabezas.",
     "en": "Zeus struck first from afar, hurling bolt after bolt at the hundred heads."
    },
    {
     "es": "Después se acercó con su hoz de diamante, la misma arma que Cronos usó contra Urano.",
     "en": "Then he closed in with his adamant sickle, the same weapon Cronus once used against Uranus."
    },
    {
     "es": "Lo hirió una y otra vez, y lo persiguió hasta el monte Casio, en Siria.",
     "en": "He wounded him again and again, and chased him to Mount Casius, in Syria."
    },
    {
     "es": "Tifón estaba herido, pero todavía no estaba vencido.",
     "en": "Typhon was wounded, but he was not yet beaten."
    }
   ],
