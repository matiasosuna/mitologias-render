   },
   "frases": [
    {
     "es": "Cuando los dioses lo vieron venir, el miedo fue más fuerte que su orgullo.",
     "en": "When the gods saw him coming, fear proved stronger than their pride."
    },
    {
     "es": "Huyeron todos hacia Egipto, y para esconderse tomaron forma de animales.",
     "en": "They all fled to Egypt, and to hide they took the shapes of animals."
    },
    {
     "es": "Según cuentan los poetas, Apolo se volvió un cuervo, Hera una vaca blanca y Hermes un ibis.",
     "en": "The poets say Apollo became a crow, Hera a white cow, and Hermes an ibis."
    },
    {
     "es": "Ártemis se convirtió en gata, Dioniso en cabra, y Afrodita se escondió bajo el agua como un pez.",
     "en": "Artemis became a cat, Dionysus a goat, and Aphrodite hid beneath the water as a fish."
    },
    {
     "es": "Solo uno se quedó para enfrentar al monstruo: Zeus.",
     "en": "Only one stayed to face the monster: Zeus."
    }
   ],
