   "frases": [
    {
     "es": "Zeus lo persiguió con sus rayos hasta el monte Nisa.",
     "en": "Zeus chased him with his thunderbolts to Mount Nysa."
    },
    {
     "es": "Allí lo esperaban las Moiras, las tres diosas que hilan el destino de todos los seres.",
     "en": "There the Fates were waiting, the three goddesses who spin the destiny of every living thing."
    },
    {
     "es": "Le ofrecieron unos frutos y le prometieron que con ellos se volvería invencible.",
     "en": "They offered him some fruits and promised that they would make him invincible."
    },
    {
     "es": "Tifón los comió con hambre, pero eran los frutos efímeros, los que solo duran un día.",
     "en": "Typhon ate them hungrily, but they were the ephemeral fruits, the kind that last only a day."
    },
    {
     "es": "En lugar de darle fuerza, lo dejaron débil.",
     "en": "Instead of giving him strength, they left him weak."
    }
