    ]
   },
   "frases": [
    {
     "es": "Tifón era más alto que todas las montañas, y su cabeza rozaba las estrellas.",
     "en": "Typhon stood taller than every mountain, and his head brushed the stars."
    },
    {
     "es": "Con los brazos abiertos, una mano tocaba el oriente y la otra el occidente.",
     "en": "With his arms spread wide, one hand touched the east and the other the west."
    },
    {
     "es": "De sus hombros brotaban cien cabezas de serpiente, con lenguas negras que no paraban de moverse.",
     "en": "A hundred serpent heads sprouted from his shoulders, black tongues flickering without rest."
    },
    {
     "es": "Debajo de la cintura, su cuerpo se volvía un remolino de serpientes enormes.",
     "en": "Below the waist, his body became a whirlpool of enormous snakes."
    },
    {
     "es": "Tenía alas en la espalda, y de sus ojos salía fuego.",
     "en": "He had wings on his back, and fire poured from his eyes."
    }
   ],
