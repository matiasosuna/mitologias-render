   "frases": [
    {
     "es": "Pero Zeus no estaba del todo solo.",
     "en": "But Zeus was not entirely alone."
    },
    {
     "es": "Hermes, el dios más astuto, y Egipán, un ser con patas de cabra, se acercaron a la cueva en silencio.",
     "en": "Hermes, the cleverest god, and Aegipan, a creature with goat legs, crept toward the cave in silence."
    },
    {
     "es": "Mientras Delfine vigilaba, ellos robaron los tendones sin que nadie lo notara.",
     "en": "While Delphyne kept watch, they stole the sinews without anyone noticing."
    },
    {
     "es": "Se los devolvieron a Zeus, y el rey de los dioses recuperó toda su fuerza.",
     "en": "They gave them back to Zeus, and the king of the gods regained all his strength."
    },
    {
     "es": "Subió a un carro tirado por caballos alados y salió a buscar a Tifón.",
     "en": "He climbed into a chariot pulled by winged horses and set out to find Typhon."
    }
