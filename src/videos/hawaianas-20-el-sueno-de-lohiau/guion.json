      "frases": [
        {
          "es": "En Kauaʻi, Lohiʻau esperó. Y esperó.",
          "en": "On Kauaʻi, Lohiʻau waited. And waited."
        },
        {
          "es": "No comía. No dormía. Ya no tocaba el tambor.",
          "en": "He did not eat. He did not sleep. He no longer played his drum."
        },
        {
          "es": "La tristeza fue tan grande que Lohiʻau murió.",
          "en": "His sorrow was so great that Lohiʻau died."
        },
        {
          "es": "Su gente puso su cuerpo en una cueva, en lo alto de un acantilado.",
          "en": "His people laid his body in a cave, high up on a cliff."
        },
        {
          "es": "¿Fue justo que Pele lo dejara así, con solo una promesa?",
          "en": "Was it fair of Pele to leave him like that, with nothing but a promise?"
        }
