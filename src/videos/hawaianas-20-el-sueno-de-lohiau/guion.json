        ]
      },
      "frases": [
        {
          "es": "Pele se tiró al agua y nadó, siguiendo la música, hasta Hāʻena, en la punta norte de Kauaʻi.",
          "en": "Pele plunged into the water and swam, following the music, to Hāʻena, at the northern tip of Kauaʻi."
        },
        {
          "es": "Allí había una gran casa de hula, llena de gente de toda la isla.",
          "en": "There stood a great hula house, full of people from all over the island."
        },
        {
          "es": "En el centro, tocando el tambor, estaba el jefe de Kauaʻi: Lohiʻau.",
          "en": "In the middle, playing the drum, sat the chief of Kauaʻi: Lohiʻau."
        },
        {
          "es": "Era joven, apuesto, y el mejor bailarín y tamborilero de la isla.",
          "en": "He was young and handsome, the finest dancer and drummer on the island."
        }
      ],
