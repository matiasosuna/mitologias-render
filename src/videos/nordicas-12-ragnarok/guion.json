      "frases": [
        {
          "es": "En el cielo, dos lobos persiguen al Sol y a la Luna desde el principio de los tiempos.",
          "en": "In the sky, two wolves have chased the Sun and the Moon since the beginning of time."
        },
        {
          "es": "Se llaman Sköll y Hati, y en el fin por fin los alcanzan.",
          "en": "Their names are Skoll and Hati, and at the end they finally catch them."
        },
        {
          "es": "Sköll se traga el Sol. Hati se traga la Luna.",
          "en": "Skoll swallows the Sun. Hati swallows the Moon."
        },
        {
          "es": "Las estrellas se desprenden y caen del cielo, y el mundo queda en una oscuridad total.",
          "en": "The stars break loose and fall from the sky, and the world is left in total darkness."
        }
