      "frases": [
        {
          "es": "Tláloc subió al cielo y se convirtió en el sol. Comenzó la tercera época.",
          "en": "Tlaloc rose into the sky and became the sun. The third age began."
        },
        {
          "es": "Los mexicas la llamaban Nahui Quiáhuitl, Cuatro Lluvia: el Sol de Lluvia.",
          "en": "The Mexica called it Nahui Quiahuitl, Four Rain: the Rain Sun."
        },
        {
          "es": "Bajo su luz, la tierra se llenó otra vez de plantas y de gente.",
          "en": "Under his light, the earth filled up once again with plants and people."
        },
        {
          "es": "Según la Leyenda de los Soles, este sol duró trescientos doce años.",
          "en": "According to the Legend of the Suns, this sun lasted three hundred and twelve years."
        }
