      "frases": [
        {
          "es": "Arriba, en la luz, Hiku corrió a la casa donde estaba el cuerpo de Kawelu.",
          "en": "Up in the light, Hiku ran to the house where Kawelu's body lay."
        },
        {
          "es": "Abrió la cáscara, y le devolvió el alma por la planta del pie.",
          "en": "He opened the shell, and put her soul back in through the sole of her foot."
        },
        {
          "es": "Después le frotó los pies y las piernas, empujando el alma despacio hacia el corazón.",
          "en": "Then he rubbed her feet and her legs, pushing the soul slowly up, toward her heart."
        },
        {
          "es": "Kawelu respiró. Abrió los ojos. Estaba viva.",
          "en": "Kawelu took a breath. She opened her eyes. She was alive."
        }
