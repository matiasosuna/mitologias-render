      "frases": [
        {
          "es": "Tāwhaki se agarró de la enredadera con raíces y empezó a subir, recitando un karakia.",
          "en": "Tāwhaki took hold of the rooted vine and began to climb, chanting a karakia, a sacred chant."
        },
        {
          "es": "No miró hacia abajo. Subió y subió, hasta llegar al cielo.",
          "en": "He did not look down. Up and up he went, until he reached the sky."
        },
        {
          "es": "Allá arriba, se disfrazó de viejo feo.",
          "en": "Up there, he disguised himself as an ugly old man."
        },
        {
          "es": "Encontró a los hermanos de Tangotango, que tallaban canoas.",
          "en": "He found Tangotango's brothers, hewing canoes."
        },
        {
          "es": "No lo reconocieron, y obligaron al viejo a cargar sus hachas.",
          "en": "They did not know him, and they made the old man carry their axes."
