        {
          "es": "De su pelo crecieron árboles, flores y hierbas.",
          "en": "From her hair grew trees, flowers and herbs."
        },
        {
          "es": "De su piel salió el pasto. De sus ojos, pozos y manantiales.",
          "en": "From her skin came grass. From her eyes came wells and springs."
        },
        {
          "es": "De su boca, ríos y grandes cuevas. De su nariz, valles.",
          "en": "From her mouth came rivers and great caves. From her nose, valleys."
        },
        {
          "es": "De sus hombros, montañas.",
          "en": "From her shoulders, mountains."
        }
