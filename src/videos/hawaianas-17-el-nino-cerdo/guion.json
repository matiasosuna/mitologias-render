      "frases": [
        {
          "es": "La abuela lo crió, y Kamapuaʻa creció grande y fuerte.",
          "en": "His grandmother raised him, and Kamapuaʻa grew big and strong."
        },
        {
          "es": "Era un kupua: un ser que podía cambiar de forma cuando quería.",
          "en": "He was a kupua: a being who could change his shape whenever he wished."
        },
        {
          "es": "Como hombre era alto y apuesto, con ojos que brillaban.",
          "en": "As a man, he was tall and handsome, with sparkling eyes."
        },
        {
          "es": "Pero tenía cerdas de cerdo en la espalda, y las escondía bajo una capa.",
          "en": "But he had pig bristles down his back, and he hid them under a cape."
        },
        {
          "es": "Y cuando quería, se volvía un jabalí enorme, de colmillos largos.",
          "en": "And whenever he wanted, he became a huge boar with long tusks."
        }
      ],
