      },
      "frases": [
        {
          "es": "Nació en Kaluanui, en la costa norte de Oʻahu. Su madre era Hina, y su padre, el jefe Kahikiʻula.",
          "en": "He was born at Kaluanui, on the north coast of Oʻahu. His mother was Hina, and his father was the chief Kahikiʻula."
        },
        {
          "es": "Pero nació antes de tiempo, sin una forma de bebé, y su hermano mayor quiso tirarlo.",
          "en": "But he was born too early, without a baby's shape, and his older brother tried to throw him away."
        },
        {
          "es": "Cuando Hina salió de su baño, encontró sobre su falda un cerdito recién nacido.",
          "en": "When Hina came out of her bath, she found a newborn piglet lying on her skirt."
        },
        {
          "es": "Lo llevaron a la abuela, Kamaunuaniho, una hechicera sabia.",
          "en": "They took him to his grandmother, Kamaunuaniho, a wise sorceress."
        },
        {
          "es": "Ella lo miró y entendió enseguida: era su nieto, y no era un cerdo común.",
          "en": "She looked at him and understood at once: this was her grandson, and no ordinary pig."
        }
      ],
