   "frases": [
    {
     "es": "Zeus creció a escondidas y se hizo fuerte.",
     "en": "Zeus grew up in secret, and he became strong."
    },
    {
     "es": "Entonces una diosa sabia lo ayudó.",
     "en": "Then a wise goddess helped him."
    },
    {
     "es": "Le dio a Cronos una bebida que lo hizo vomitar.",
     "en": "She gave Cronus a drink that made him throw up."
    },
    {
     "es": "Primero salió la piedra.",
     "en": "First, the stone came out."
    },
    {
     "es": "Después salieron, uno por uno, los cinco hijos que se había tragado.",
     "en": "Then the five children he had swallowed came out, one by one."
    },
    {
     "es": "Eran los hermanos de Zeus, y se unieron a él para pelear contra Cronos.",
     "en": "They were Zeus's brothers and sisters, and they joined him to fight Cronus."
    }
   ],
