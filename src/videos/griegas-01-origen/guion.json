   "frases": [
    {
     "es": "Gea sufría, porque sus hijos estaban atrapados dentro de ella.",
     "en": "Gaia suffered, because her children were trapped inside her."
    },
    {
     "es": "Entonces hizo una hoz, una cuchilla curva de un metal durísimo.",
     "en": "So she made a sickle, a curved blade of very hard metal."
    },
    {
     "es": "Les pidió a sus hijos que castigaran a su padre cruel.",
     "en": "She asked her children to punish their cruel father."
    },
    {
     "es": "Todos tuvieron miedo. Solo Cronos, el Titán más joven, dijo que sí.",
     "en": "They were all afraid. Only Cronus, the youngest Titan, said yes."
    },
    {
     "es": "De noche, Urano llegó y se tendió otra vez sobre Gea.",
     "en": "At night, Uranus came and lay down over Gaia again."
    },
    {
     "es": "Gea había escondido a Cronos. Él saltó y cortó a Urano con la hoz.",
     "en": "Gaia had hidden Cronus. He jumped out and cut Uranus with the sickle."
    }
