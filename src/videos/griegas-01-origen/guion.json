   },
   "frases": [
    {
     "es": "Gea sufría con sus hijos atrapados dentro de ella, y decidió vengarse.",
     "en": "Gaia suffered with her children trapped inside her, and she decided to take revenge."
    },
    {
     "es": "Forjó una gran hoz de metal indestructible y pidió ayuda a los Titanes.",
     "en": "She forged a great sickle of unbreakable metal and asked the Titans for help."
    },
    {
     "es": "Solo uno se atrevió: Cronos, el más joven y el más ambicioso.",
     "en": "Only one dared: Cronus, the youngest and the most ambitious."
    },
    {
     "es": "Esa noche, cuando Urano bajó a cubrir la Tierra, Cronos lo atacó con la hoz y lo separó de ella para siempre.",
     "en": "That night, when Uranus came down to cover the Earth, Cronus struck him with the sickle and separated them forever."
    },
    {
     "es": "Por eso, desde entonces, el cielo está arriba y la tierra abajo.",
     "en": "That is why, ever since, the sky has been above and the earth below."
    },
    {
     "es": "De la espuma del mar, donde cayó la sangre de Urano, nació la diosa más bella: Afrodita.",
     "en": "From the sea foam, where the blood of Uranus fell, the most beautiful goddess was born: Aphrodite."
    }
   ],
