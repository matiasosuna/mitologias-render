   "frases": [
    {
     "es": "Así empezó la Titanomaquia, la guerra entre los dioses jóvenes y los Titanes.",
     "en": "So began the Titanomachy, the war between the young gods and the Titans."
    },
    {
     "es": "Los Titanes peleaban desde el monte Otris; los jóvenes dioses, desde el Olimpo.",
     "en": "The Titans fought from Mount Othrys; the young gods, from Olympus."
    },
    {
     "es": "Durante diez años las montañas temblaron y el mar hirvió.",
     "en": "For ten years the mountains shook and the sea boiled."
    },
    {
     "es": "Para ganar, Zeus bajó al Tártaro y liberó a los Cíclopes y a los gigantes de cien brazos.",
     "en": "To win, Zeus went down to Tartarus and freed the Cyclopes and the hundred-armed giants."
    },
    {
     "es": "En agradecimiento, los Cíclopes le forjaron el rayo a Zeus, el tridente a Poseidón y un casco de invisibilidad a Hades.",
     "en": "In gratitude, the Cyclopes forged the thunderbolt for Zeus, the trident for Poseidon and a helmet of invisibility for Hades."
    },
    {
     "es": "Los gigantes de cien brazos lanzaron trescientas rocas a la vez, y los Titanes quedaron sepultados.",
     "en": "The hundred-armed giants hurled three hundred rocks at once, and the Titans were buried."
    }
   ],
