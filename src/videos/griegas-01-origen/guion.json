   "frases": [
    {
     "es": "Ahora Cronos era el rey, y se casó con su hermana Rea.",
     "en": "Now Cronus was king, and he married his sister Rhea."
    },
    {
     "es": "Pero Gea y Urano le advirtieron que uno de sus hijos lo vencería.",
     "en": "But Gaia and Uranus warned him: one of his sons would defeat him."
    },
    {
     "es": "Por eso, cada vez que Rea tenía un bebé, Cronos se lo tragaba.",
     "en": "That is why, each time Rhea had a baby, Cronus swallowed it."
    },
    {
     "es": "Se tragó cinco bebés, uno tras otro.",
     "en": "He swallowed five babies, one after another."
    },
    {
     "es": "La pena de Rea no terminaba nunca, porque seguía perdiendo a sus hijos.",
     "en": "Rhea's grief never ended, because she kept losing her children."
    }
   ],
