      "frases": [
        {
          "es": "Desde arriba, Hiʻiaka miró hacia Puna, hacia la casa de Hōpoe junto al mar.",
          "en": "From up high, Hiʻiaka looked back toward Puna, toward Hōpoe's home by the sea."
        },
        {
          "es": "El humo del volcán bajaba hacia allá y oscurecía el bosque.",
          "en": "Smoke from the volcano was drifting that way, darkening the forest."
        },
        {
          "es": "A Hiʻiaka se le encogió el corazón. Temía que fuera una mala señal.",
          "en": "Hiʻiaka's heart sank. She feared it was a bad sign."
        },
        {
          "es": "¿Tú le habrías confiado a Pele tu mejor amiga?",
          "en": "Would you have trusted Pele with your best friend?"
        }
      ],
