      },
      "frases": [
        {
          "es": "Faltaba una: Hiʻiaka. Estaba en la playa con su amiga Hōpoe, nadando y haciendo lei.",
          "en": "One was missing: Hiʻiaka. She was at the beach with her friend Hōpoe, swimming and making lei."
        },
        {
          "es": "La voz de Pele llegó desde el cráter, por encima del bosque y de las colinas.",
          "en": "Pele's voice came from the crater, over the forest and the hills."
        },
        {
          "es": "Hiʻiaka se despidió de Hōpoe y, con su magia, en un momento llegó al volcán.",
          "en": "Hiʻiaka said goodbye to Hōpoe and, by her magic, reached the volcano in a moment."
        },
        {
          "es": "Llegó cubierta de los lei que le había hecho Hōpoe, y bailó para sus hermanas.",
          "en": "She arrived covered in the lei Hōpoe had made for her, and she danced for her sisters."
        }
      ],
