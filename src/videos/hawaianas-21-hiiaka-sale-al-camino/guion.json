    {
      "id": "promesa",
      "fondo": "crater",
      "camara": {
        "de": 0,
        "a": 150,
        "zoom": [
          1,
          1.05
        ]
      },
      "frases": [
        {
          "es": "«Voy», dijo Hiʻiaka. «Pero tú también tienes que prometerme algo.»",
          "en": "\"I will go,\" said Hiʻiaka. \"But you must promise me something too.\""
        },
        {
          "es": "«Cuida mi bosque de lehua. No lo quemes.»",
          "en": "\"Take care of my lehua forest. Do not burn it.\""
        },
        {
          "es": "«Puedes enojarte. Puedes quemar tierra adentro y hacia el mar. Pero no toques a mi amiga Hōpoe.»",
          "en": "\"You may get angry. You may burn inland and toward the sea. But do not touch my friend Hōpoe.\""
        },
        {
          "es": "«Está bien», dijo Pele. «Voy a cuidar tu bosque y a tu amiga.» Era un juramento.",
          "en": "\"Very well,\" said Pele. \"I will care for your forest and your friend.\" It was a solemn oath."
        }
      ],
