      "frases": [
        {
          "es": "De Cristo, por el don del Espíritu, salieron cuatro luces.",
          "en": "From Christ, by the gift of the Spirit, four lights came forth."
        },
        {
          "es": "El Hijo quiso que estuvieran a su lado.",
          "en": "The Son wanted them to stand beside him."
        },
        {
          "es": "Son cuatro grandes luces: grandes seres llenos de luz.",
          "en": "They are four great lights: great beings full of light."
        },
        {
          "es": "Con ellas están tres poderes: la Voluntad, el Pensamiento y la Vida.",
          "en": "With them stand three powers: Will, Thought, and Life."
        },
        {
          "es": "Y cuatro poderes más: el Entendimiento, la Gracia, la Percepción y la Prudencia.",
          "en": "And four more powers: Understanding, Grace, Perception, and Prudence."
        }
