      "frases": [
        {
          "es": "La tradición dice que el canto se hizo para el nacimiento de un gran jefe.",
          "en": "Tradition says the chant was made for the birth of a high chief."
        },
        {
          "es": "Es larguísimo: más de dos mil versos, en dieciséis partes.",
          "en": "It is very long: more than two thousand lines, divided into sixteen parts."
        },
        {
          "es": "Nombra la familia del jefe, desde el comienzo del mundo hasta él.",
          "en": "It names the chief's family line, from the start of the world down to him."
        },
        {
          "es": "Se creía que un solo error al cantarlo traía mala suerte a la familia.",
          "en": "One mistake while chanting was believed to bring bad luck to the family."
        },
        {
          "es": "Por eso solo podían cantarlo los maestros del canto, que sabían cada verso de memoria.",
          "en": "So only trained masters of song, who knew every line by heart, could chant it."
        }
      ],
