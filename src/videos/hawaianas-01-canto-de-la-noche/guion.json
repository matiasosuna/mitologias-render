      "frases": [
        {
          "es": "Después el canto dice que la oscuridad hizo más oscuridad, y la noche hizo más noche.",
          "en": "Then the chant says the darkness made more darkness, and the night made more night."
        },
        {
          "es": "Era un negro hondo, muy hondo. Hasta el sol estaba oscuro. Nada más que noche.",
          "en": "It was a deep, deep black. Even the sun was dark. Nothing but night."
        },
        {
          "es": "Esta oscuridad es Pō. Y entonces, dice el canto, la noche dio a luz.",
          "en": "This darkness is Pō. And then, the chant says, the night gave birth."
        }
