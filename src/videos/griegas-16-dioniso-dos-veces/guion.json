      "frases": [
        {
          "es": "Hera estaba furiosa. Otra vez, su esposo amaba a otra.",
          "en": "Hera was furious. Once again, her husband loved someone else."
        },
        {
          "es": "No quería solo castigar a Sémele. Quería que desapareciera para siempre.",
          "en": "She did not want only to punish Semele. She wanted her gone forever."
        },
        {
          "es": "Así que pensó en un truco cruel.",
          "en": "So she thought of a cruel trick."
        },
        {
          "es": "Se transformó en una anciana: Béroe, la nodriza que había cuidado a Sémele de niña.",
          "en": "She changed into an old woman: Beroe, the nurse who had cared for Semele as a child."
        }
