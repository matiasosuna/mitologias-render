      "frases": [
        {
          "es": "En Tebas vivía Sémele, una princesa. Su padre, el rey Cadmo, había fundado la ciudad.",
          "en": "In Thebes lived Semele, a princess. Her father, King Cadmus, had founded the city."
        },
        {
          "es": "Zeus, el rey de los dioses, se enamoró de ella.",
          "en": "Zeus, the king of the gods, fell in love with her."
        },
        {
          "es": "La visitaba en secreto, con la forma de un hombre.",
          "en": "He visited her in secret, in the shape of a man."
        },
        {
          "es": "Pronto, Sémele iba a tener un bebé, un hijo de Zeus.",
          "en": "Soon, Semele was going to have a baby, a child of Zeus."
        },
        {
          "es": "Pero alguien en el Olimpo estaba mirando: Hera, la esposa de Zeus.",
          "en": "But someone on Olympus was watching: Hera, the wife of Zeus."
        }
