      "frases": [
        {
          "es": "El agua subió y subió, hasta cubrirlo todo, hasta las montañas.",
          "en": "The water rose and rose, until it covered everything, even the mountains."
        },
        {
          "es": "Waynaboozhoo sobrevivió. Flotaba sobre un tronco enorme, con muchos animales y aves.",
          "en": "Waynaboozhoo survived. He floated on a huge log, with many animals and birds."
        },
        {
          "es": "Se turnaban para descansar en el tronco. Pero no había tierra en ninguna parte.",
          "en": "They took turns resting on the log. But there was no land anywhere."
        },
        {
          "es": "En algunas versiones, Waynaboozhoo se zambulló primero. Pero el agua era demasiado honda.",
          "en": "In some tellings, Waynaboozhoo dove down first himself. But the water was far too deep."
        }
