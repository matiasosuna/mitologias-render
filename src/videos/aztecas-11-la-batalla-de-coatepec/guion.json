      "frases": [
        {
          "es": "Sus cuatrocientos hijos se enojaron muchísimo: \"¿Quién es el padre? ¡Qué vergüenza!\"",
          "en": "Her four hundred sons were furious: \"Who is the father? What a disgrace!\""
        },
        {
          "es": "Coyolxauhqui, la hermana mayor, los convenció de matar a su madre.",
          "en": "Coyolxauhqui, the eldest sister, persuaded them to kill their mother."
        },
        {
          "es": "Coyolxauhqui los guiaba, con cascabeles de oro en las mejillas.",
          "en": "Coyolxauhqui led them, with golden bells on her cheeks."
        },
        {
          "es": "Se pusieron sus ropas de guerra y se pintaron la cara.",
          "en": "They put on their war clothes and painted their faces."
        }
      ],
