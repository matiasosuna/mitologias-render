      "frases": [
        {
          "es": "Para pasar el tiempo, Völund fue a su fragua y forjó anillos de oro rojo.",
          "en": "To pass the time, Volund went to his forge and made rings of red gold."
        },
        {
          "es": "Hizo setecientos, y los ató todos en un cordel.",
          "en": "He made seven hundred of them, and he tied them all together on a cord."
        },
        {
          "es": "Cada anillo era un regalo para su esposa. Esperaba que volviera y se los pusiera.",
          "en": "Each ring was a gift for his wife. He hoped she would come back and wear them."
        },
        {
          "es": "Pero corrió la voz de que el gran herrero estaba solo en el valle, con un tesoro de oro.",
          "en": "But word spread that the great smith was alone in the valley, with a hoard of gold."
        }
      ],
