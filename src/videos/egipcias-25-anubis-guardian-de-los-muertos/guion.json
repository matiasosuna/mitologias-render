      "frases": [
        {
          "es": "Thoth escribía el veredicto de los muertos, pero alguien tenía que llevarlos hasta la sala del juicio.",
          "en": "Thoth wrote down the verdict of the dead, but someone had to lead them to the hall of judgment."
        },
        {
          "es": "Ese guía tenía cabeza de chacal, un animal salvaje parecido a un perro que vive en el desierto.",
          "en": "That guide had the head of a jackal, a wild, dog-like animal of the desert."
        },
        {
          "es": "Era Anubis. Su nombre egipcio era Inpu.",
          "en": "He was Anubis. His Egyptian name was Inpu."
        },
        {
          "es": "Hoy preguntamos por qué un chacal, y por qué negro.",
          "en": "Today we ask why a jackal, and why black."
        }
      ],
