      "frases": [
        {
          "es": "Cuando la momia estaba lista, había que despertar los sentidos del muerto.",
          "en": "When the mummy was ready, the senses of the dead person had to be awakened."
        },
        {
          "es": "Los sacerdotes tocaban la boca, los ojos y los oídos con herramientas especiales.",
          "en": "Priests touched the mouth, eyes, and ears with special tools."
        },
        {
          "es": "Este rito se llamaba la apertura de la boca. Así el muerto podía respirar, hablar y comer de nuevo.",
          "en": "This ritual was called the Opening of the Mouth. It let the dead breathe, speak, and eat again."
        },
        {
          "es": "En las pinturas de las tumbas, Anubis se inclina sobre la momia para protegerla.",
          "en": "In tomb paintings, Anubis often bends over the mummy to protect it."
        }
      ],
