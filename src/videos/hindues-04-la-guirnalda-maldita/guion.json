      "frases": [
        {
          "es": "El rey de los devas era Indra, señor del trueno y de la lluvia. En la mano lleva el vajra, un rayo de diamante.",
          "en": "The king of the devas was Indra, lord of thunder and rain. In his hand he holds the vajra, a diamond thunderbolt."
        },
        {
          "es": "Montaba a Airavata, un elefante blanco y enorme.",
          "en": "He rode Airavata, a huge white elephant."
        },
        {
          "es": "En aquellos días, Indra era poderoso y rico. Y estaba muy seguro de sí mismo.",
          "en": "In those days, Indra was mighty and rich. And he was very sure of himself."
        },
        {
          "es": "Quizá demasiado.",
          "en": "Perhaps too sure."
        }
      ],
