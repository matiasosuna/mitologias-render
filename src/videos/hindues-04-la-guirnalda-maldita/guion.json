      "frases": [
        {
          "es": "Y la maldición se cumplió. El cielo empezó a apagarse.",
          "en": "And the curse came true. Heaven began to fade."
        },
        {
          "es": "Las plantas se secaron. Los sacrificios se olvidaron. Los dioses se sintieron débiles y cansados.",
          "en": "Plants withered. Offerings were forgotten. The gods felt weak and tired."
        },
        {
          "es": "El Vishnu Purana dice que hasta Lakshmi, la diosa de la fortuna, abandonó los tres mundos.",
          "en": "The Vishnu Purana says that even Lakshmi, the goddess of fortune, left the three worlds."
        },
        {
          "es": "Sin fortuna y sin fuerza, los dioses estaban indefensos.",
          "en": "Without fortune and without strength, the gods were defenseless."
        }
      ],
