      "frases": [
        {
          "es": "Durvasa, con respeto, le regaló la guirnalda al rey de los dioses.",
          "en": "Durvasa respectfully gave the garland to the king of the gods."
        },
        {
          "es": "Indra la recibió sin bajarse del elefante… y se la colgó a Airavata en la cabeza.",
          "en": "Indra took it without getting off the elephant… and hung it on Airavata's head."
        },
        {
          "es": "El elefante, atraído por el perfume, la tomó con la trompa, la olió… y la tiró al suelo.",
          "en": "The elephant, drawn by the scent, took it with its trunk, sniffed it… and threw it to the ground."
        },
        {
          "es": "Y Airavata la pisó.",
          "en": "And Airavata trampled it."
        }
