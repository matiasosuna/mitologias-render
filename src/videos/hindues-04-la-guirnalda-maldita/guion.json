      "frases": [
        {
          "es": "En las historias hindúes hay dos grandes familias de seres poderosos.",
          "en": "In Hindu stories there are two great families of powerful beings."
        },
        {
          "es": "Los devas son los dioses del cielo: el sol, la lluvia, el fuego, el viento.",
          "en": "The devas are the gods of the sky: the sun, the rain, the fire, the wind."
        },
        {
          "es": "Los asuras son sus primos, igual de fuertes, y casi siempre sus rivales.",
          "en": "The asuras are their cousins, just as strong, and almost always their rivals."
        },
        {
          "es": "Ojo: los asuras no son simplemente \"los malos\". Algunos son sabios y generosos. Ya lo vas a ver.",
          "en": "Careful: the asuras are not simply \"the bad guys.\" Some of them are wise and generous. You will see."
        }
      ],
