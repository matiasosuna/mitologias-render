      "frases": [
        {
          "es": "Eran muchos hijos, todos dioses. Seis de ellos importan más en esta historia.",
          "en": "There were many children, all of them gods. Six of them matter most in this story."
        },
        {
          "es": "Tāne, dios de los bosques y las aves. Y Tangaroa, dios del mar y los peces.",
          "en": "Tāne, god of the forests and the birds. And Tangaroa, god of the sea and the fish."
        },
        {
          "es": "Tūmatauenga, o Tū, el dios de la guerra y de la gente.",
          "en": "Tūmatauenga, or Tū for short, the god of war, and of people."
        },
        {
          "es": "Rongo, dios del kūmara, la batata. Y Haumia, dios de la comida silvestre, como la raíz de helecho.",
          "en": "Rongo, god of the kūmara, the sweet potato. And Haumia, god of wild food, like fern root."
        },
        {
          "es": "Y Tāwhirimātea, dios de los vientos y las tormentas. Recuérdalo.",
          "en": "And Tāwhirimātea, god of the winds and storms. Remember him."
        }
      ],
