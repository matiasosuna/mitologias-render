      "frases": [
        {
          "es": "Los hijos no tenían lugar para pararse. Andaban agachados entre sus padres.",
          "en": "The children had no room to stand up. They crawled and crouched between their parents."
        },
        {
          "es": "Vivían en el frío y en la oscuridad, y nunca habían visto el día.",
          "en": "They lived in the cold and the dark, and they had never seen the day."
        },
        {
          "es": "Año tras año, se fueron cansando de esa noche sin fin.",
          "en": "Year after year, they grew more and more tired of that endless night."
        }
      ],
