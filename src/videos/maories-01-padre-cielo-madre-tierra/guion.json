      "frases": [
        {
          "es": "Rongo lo intentó primero. Empujó el Cielo con todas sus fuerzas. No se movió.",
          "en": "Rongo tried first. He pushed against the Sky with all his strength. It did not move."
        },
        {
          "es": "Después lo intentaron Tangaroa y Haumia. Nada.",
          "en": "Then Tangaroa tried, and then Haumia. Nothing."
        },
        {
          "es": "Tūmatauenga golpeó los lazos que unían a sus padres. Aun así, no se separaron.",
          "en": "Tūmatauenga struck at the bonds that held his parents together. Still they would not part."
        }
      ],
