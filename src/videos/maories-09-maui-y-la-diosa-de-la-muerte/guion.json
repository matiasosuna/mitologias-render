      "frases": [
        {
          "es": "Māui tenía un plan, audaz y simple.",
          "en": "Māui had a plan, bold and simple."
        },
        {
          "es": "Entraría en el cuerpo de Hine-nui-te-pō mientras ella dormía, y saldría por su boca.",
          "en": "He would go into the body of Hine-nui-te-pō while she slept, and come out through her mouth."
        },
        {
          "es": "Si lograba atravesarla y salir con vida, la muerte misma quedaría vencida.",
          "en": "If he could pass all the way through her and live, death itself would be defeated."
        },
        {
          "es": "Nadie volvería a morir nunca más.",
          "en": "No one would ever die again."
        },
        {
          "es": "Sería la travesura más grande de todas.",
          "en": "It would be the greatest trick of all."
        }
      ],
