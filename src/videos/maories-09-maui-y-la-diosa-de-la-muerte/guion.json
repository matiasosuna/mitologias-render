      "frases": [
        {
          "es": "Viajaron hasta donde el cielo toca la tierra. Y allí la encontraron.",
          "en": "They travelled to where the sky meets the land. And there they found her."
        },
        {
          "es": "Hine-nui-te-pō dormía. Era inmensa y estaba quieta, como una montaña oscura.",
          "en": "Hine-nui-te-pō was asleep. She was vast and still, like a dark mountain."
        },
        {
          "es": "Māui se ató bien a la muñeca las cuerdas de su arma.",
          "en": "Māui tied the cords of his weapon tight around his wrist."
        },
        {
          "es": "Después se hizo pequeño, muy pequeño.",
          "en": "Then he made himself small. Very small."
        },
        {
          "es": "«Recuerden», les susurró a los pájaros. «Ni un sonido.»",
          "en": "'Remember,' he whispered to the birds. 'Not a sound.'"
        }
      ],
