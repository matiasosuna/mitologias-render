    {
      "id": "descripcion",
      "fondo": "rua_ra",
      "camara": {
        "de": 0,
        "a": 150,
        "zoom": [
          1,
          1.05
        ]
      },
      "frases": [
        {
          "es": "«Mira allá, donde el cielo toca la tierra. Ese brillo rojo que relampaguea: son sus ojos.»",
          "en": "'Look there, where the sky meets the land. That red glow, flashing: those are her eyes.'"
        },
        {
          "es": "«El centro de sus ojos es pounamu, jade verde. Sus dientes son filosos como vidrio volcánico.»",
          "en": "'The centres of her eyes are pounamu, green jade. Her teeth are sharp as volcanic glass.'"
        },
        {
          "es": "«Su boca es como la de una barracuda, y su pelo es como algas largas y enredadas.»",
          "en": "'Her mouth is like a barracouta's, and her hair is like long, tangled seaweed.'"
        },
        {
          "es": "Māui se rió. «Yo atrapé al sol y lo golpeé hasta que anduvo despacio. ¿Ella es más fuerte que el sol?»",
          "en": "Māui laughed. 'I caught the sun and beat him until he went slowly. Is she stronger than the sun?'"
        }
      ],
