      "frases": [
        {
          "es": "Al final de la vida, Thoth tenía otro trabajo.",
          "en": "At the end of life, Thoth had another job."
        },
        {
          "es": "En la sala del juicio, el corazón del muerto se pesaba contra la pluma de Maat.",
          "en": "In the hall of judgment, the heart of the dead was weighed against the feather of Maat."
        },
        {
          "es": "Thoth estaba junto a la balanza, con su pluma de caña, y escribía el resultado.",
          "en": "Thoth stood by the scale with his reed pen and wrote down the result."
        },
        {
          "es": "Si el corazón era ligero, Osiris dejaba pasar al muerto. Si pesaba, lo devoraba Ammit.",
          "en": "If the heart was light, Osiris let the dead pass. If it was heavy, Ammit devoured it."
        },
        {
          "es": "Nadie podía discutir lo que Thoth escribía. Su registro era la última palabra.",
          "en": "Nobody could argue with what Thoth wrote. His record had the last word."
        }
      ],
