      },
      "frases": [
        {
          "es": "La tierra estaba verde otra vez, fresca y limpia, como si el mundo se hiciera por primera vez.",
          "en": "The earth was green again, fresh and clean, as if the world were being made for the first time."
        },
        {
          "es": "Caían cascadas desde las colinas nuevas, y los campos que nadie había sembrado empezaban a dar su grano.",
          "en": "Waterfalls fell from the new hills, and fields that no one had sown began to bear their grain."
        },
        {
          "es": "Sobre las cascadas volaba un águila, y cazaba peces en el agua que corría.",
          "en": "Above the falls an eagle soared, hunting fish in the rushing water."
        },
        {
          "es": "El mundo, lavado por el mar, estaba listo para ser vivido de nuevo.",
          "en": "The world, washed clean by the sea, was ready to be lived in again."
        }
