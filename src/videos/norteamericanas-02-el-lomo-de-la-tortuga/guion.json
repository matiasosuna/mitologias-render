      "frases": [
        {
          "es": "Primero fue el Colimbo, el ave que bucea más hondo que cualquier otra.",
          "en": "First went the Loon, a bird that can dive deeper than almost any other bird."
        },
        {
          "es": "Se zambulló y estuvo abajo mucho, mucho tiempo.",
          "en": "He dove under, and he stayed down for a long, long time."
        },
        {
          "es": "Cuando volvió a salir, jadeaba. Y su pico estaba vacío.",
          "en": "When he came back up, he was gasping for air. And his beak was empty."
        }
      ],
