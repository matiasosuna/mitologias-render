      "frases": [
        {
          "es": "Luego lo intentó la Nutria, rápida y fuerte. Bajó y bajó hasta que le ardió el pecho.",
          "en": "Then the Otter tried. She was fast and strong, and she swam down until her chest burned."
        },
        {
          "es": "Volvió sin nada.",
          "en": "She came back with nothing."
        },
        {
          "es": "Después fue el Castor, golpeando el agua con su cola plana al sumergirse.",
          "en": "Next came the Beaver, slapping the water with his flat tail as he went under."
        },
        {
          "es": "Él también volvió sin nada. El agua era demasiado honda.",
          "en": "He came back with nothing, too. The water was simply too deep."
        }
      ],
