        ]
      },
      "frases": [
        {
          "es": "Bajó nadando, lejos de la luz, hacia el frío y la oscuridad.",
          "en": "Down she swam, away from the light, into the cold and the dark."
        },
        {
          "es": "Le ardía el pecho. No veía nada. Pero siguió bajando.",
          "en": "Her chest burned. Her eyes could see nothing. Still she kept going."
        },
        {
          "es": "Al fin, sus patitas tocaron el fondo. Agarró un poquito de barro.",
          "en": "At last, her little paws touched the bottom. She grabbed a tiny bit of mud."
        },
        {
          "es": "Y dio la vuelta hacia la luz, que estaba muy, muy arriba.",
          "en": "Then she turned back toward the light, far, far above."
        }
      ],
