      "frases": [
        {
          "es": "El hielo que goteaba también formó una vaca enorme, llamada Audhumla.",
          "en": "The dripping ice also made a huge cow, named Audhumla."
        },
        {
          "es": "De ella corrían cuatro ríos de leche, y Ymir tomaba de ellos.",
          "en": "Four rivers of milk flowed from her, and Ymir drank from them."
        },
        {
          "es": "La vaca se alimentaba lamiendo los bloques de hielo, que eran salados.",
          "en": "The cow fed herself by licking the blocks of ice, which were salty."
        }
