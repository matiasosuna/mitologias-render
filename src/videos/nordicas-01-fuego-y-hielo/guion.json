      "frases": [
        {
          "es": "Ymir no era un dios. Era malvado, y también lo fueron todos sus hijos.",
          "en": "Ymir was not a god. He was evil, and so were all his children."
        },
        {
          "es": "Una vez, mientras Ymir dormía, empezó a sudar.",
          "en": "Once, while Ymir was asleep, he began to sweat."
        },
        {
          "es": "Del sudor debajo de su brazo crecieron un hombre y una mujer.",
          "en": "From the sweat under his arm grew a man and a woman."
        },
        {
          "es": "De ellos vinieron los gigantes de hielo, gigantes del frío como Ymir.",
          "en": "From them came the frost giants, giants of ice and cold like Ymir."
        }
