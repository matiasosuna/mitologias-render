      "frases": [
        {
          "es": "Antes de todo, no había tierra, ni cielo, ni mar.",
          "en": "Before everything, there was no earth, no sky, and no sea."
        },
        {
          "es": "Solo había un abismo enorme y vacío: Ginnungagap.",
          "en": "There was only a vast and empty gap: Ginnungagap."
        },
        {
          "es": "Al norte estaba Niflheim, un mundo de hielo, niebla y oscuridad.",
          "en": "To the north lay Niflheim, a world of ice, mist and darkness."
        },
        {
          "es": "Al sur ardía Muspelheim, un mundo de fuego tan brillante que nadie podía mirarlo.",
          "en": "To the south burned Muspelheim, a world of fire so bright that no one could look at it."
        }
      ],
