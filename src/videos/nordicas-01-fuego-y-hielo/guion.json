      "frases": [
        {
          "es": "Al principio de todo, no había tierra, ni cielo, ni mar.",
          "en": "In the very beginning, there was no earth, no sky and no sea."
        },
        {
          "es": "Solo había un abismo enorme y vacío.",
          "en": "There was only a huge, empty gap."
        },
        {
          "es": "Al norte del abismo había un mundo de hielo, niebla y oscuridad.",
          "en": "To the north of the gap lay a world of ice, mist and darkness."
        },
        {
          "es": "Al sur ardía un mundo de fuego, tan caliente y brillante que no se podía soportar.",
          "en": "To the south burned a world of fire, too hot and bright to bear."
        }
      ],
      "efectos": [
