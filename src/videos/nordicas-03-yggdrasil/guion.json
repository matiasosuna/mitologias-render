      "frases": [
        {
          "es": "Y sobre Yggdrasil descansaban nueve mundos. Empecemos por los más altos.",
          "en": "And upon Yggdrasil rested nine worlds. Let us begin with the highest."
        },
        {
          "es": "Arriba estaba Asgard, la fortaleza de los dioses Aesir, donde vivían Odín, Thor y Frigg.",
          "en": "At the top stood Asgard, the fortress of the Aesir gods, where Odin, Thor and Frigg lived."
        },
        {
          "es": "Allí también estaba Vanaheim, el hogar de los dioses Vanir, entre ellos Njord, Freyr y Freyja.",
          "en": "There too lay Vanaheim, the home of the Vanir gods, among them Njord, Freyr and Freyja."
        },
        {
          "es": "Y Alfheim, el mundo de la luz, donde vivían los elfos luminosos; los dioses se lo regalaron a Freyr.",
          "en": "And Alfheim, the world of light, where the light elves lived; the gods gave it to Freyr as a gift."
        }
      ],
