      "frases": [
        {
          "es": "Nueve mundos descansan sobre Yggdrasil. Empezamos por los más altos.",
          "en": "Nine worlds rest on Yggdrasil. We begin with the highest ones."
        },
        {
          "es": "Arriba está Asgard, la fortaleza de los dioses Aesir. Allí viven Odín, Thor y Frigg.",
          "en": "At the top is Asgard, fortress of the Aesir gods. Odin, Thor and Frigg live there."
        },
        {
          "es": "Cerca queda Vanaheim, el hogar de los dioses Vanir Njord, Freyr y Freyja.",
          "en": "Nearby lies Vanaheim, home of the Vanir gods Njord, Freyr and Freyja."
        },
        {
          "es": "Luego viene Alfheim, donde viven los elfos de luz. Los dioses se lo dieron a Freyr.",
          "en": "Then comes Alfheim, where the light elves live. The gods gave it to Freyr."
        }
      ],
