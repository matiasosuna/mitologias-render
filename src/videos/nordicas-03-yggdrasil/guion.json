      "frases": [
        {
          "es": "Ask y Embla, los primeros humanos, vivían en Midgard sin saber que su mundo descansaba sobre algo mucho más grande.",
          "en": "Ask and Embla, the first humans, lived in Midgard without knowing that their world rested on something far greater."
        },
        {
          "es": "Los dioses sí lo sabían: todos los mundos estaban unidos por un árbol inmenso llamado Yggdrasil.",
          "en": "The gods knew it: all the worlds were joined together by one immense tree called Yggdrasil."
        },
        {
          "es": "Era un fresno, el más grande y el mejor de todos los árboles.",
          "en": "It was an ash tree, the greatest and the finest of all trees."
        },
        {
          "es": "Sus ramas se extendían sobre cada mundo y subían más alto que el cielo.",
          "en": "Its branches spread over every world and rose higher than the sky."
        },
        {
          "es": "Y cada día, los dioses se reunían bajo ese árbol para decidir qué era justo.",
          "en": "And every day, the gods gathered beneath that tree to decide what was just."
        }
      ],
