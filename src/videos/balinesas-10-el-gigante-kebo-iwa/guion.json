      "frases": [
        {
          "es": "En la aldea de Blahbatuh, un marido y su esposa rezaron durante muchos años por un hijo.",
          "en": "In the village of Blahbatuh, a husband and wife prayed for many years for a child."
        },
        {
          "es": "Por fin nació un varón. Y tenía hambre. Mucha, mucha hambre.",
          "en": "At last a son was born. And he was hungry. Very, very hungry."
        },
        {
          "es": "Comía más de lo que toda su familia podía cultivar, y no paraba de crecer.",
          "en": "He ate more than his whole family could grow, and he kept on growing."
        },
        {
          "es": "Kebo significa búfalo de agua, un buen nombre para alguien tan grande y fuerte.",
          "en": "Kebo means water buffalo, a good name for someone so big and strong."
