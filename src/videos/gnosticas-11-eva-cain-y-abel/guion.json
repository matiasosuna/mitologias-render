          "x": 960,
          "y": 180,
          "hasta": 2
        },
        {
          "en": 2.2,
          "texto": {
            "es": "NO SE LA PUEDE ATRAPAR",
            "en": "SHE CANNOT BE GRASPED"
          },
          "x": 960,
          "y": 180
        }
      ],
      "frases": [
        {
          "en": "The forgetting had fallen over Adam, but the Epinoia of light was hidden inside him.",
          "es": "El olvido había caído sobre Adán, pero la Epinoia de luz estaba escondida dentro de él."
        },
        {
          "en": "The first ruler wanted to bring her out of Adam, through his rib.",
          "es": "El primer gobernante quiso sacarla de Adán, por su costilla."
        },
        {
          "en": "But the Epinoia of light cannot be grasped.",
          "es": "Pero a la Epinoia de luz no se la puede atrapar."
        },
        {
          "en": "The darkness chased after her, but it did not catch her.",
          "es": "La oscuridad la persiguió, pero no la alcanzó."
        }
      ]
    },
