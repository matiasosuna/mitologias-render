      "rotulos": [
        {
          "en": 1.2,
          "texto": {
            "es": "VIDA · LA MADRE DE LOS VIVIENTES",
            "en": "LIFE · THE MOTHER OF THE LIVING"
          },
          "x": 960,
          "y": 170
        }
      ],
      "frases": [
        {
          "en": "\"Our sister Sophia came down in innocence, to set right what she lacked.\"",
          "es": "\"Nuestra hermana Sofía bajó en inocencia, para corregir lo que le faltaba\"."
        },
        {
          "en": "\"That is why she was called Life, the mother of the living.\"",
          "es": "\"Por eso la llamaron Vida, la madre de los vivientes\"."
        },
        {
          "en": "\"She was named so by the providence of the power of heaven.\"",
          "es": "\"Así la nombró la providencia del poder del cielo\"."
        },
        {
          "en": "\"And through her, they tasted perfect knowledge.\"",
          "es": "\"Y por medio de ella probaron el conocimiento perfecto\"."
        }
      ]
    },
