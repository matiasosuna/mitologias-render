      ],
      "frases": [
        {
          "es": "Thrym estaba feliz. Los gigantes prepararon un banquete y la novia, con el velo puesto, se sentó a su lado.",
          "en": "Thrym was overjoyed. The giants prepared a feast, and the veiled bride sat beside him."
        },
        {
          "es": "La novia se comió un buey entero y ocho salmones, y se bebió tres barriles de hidromiel.",
          "en": "The bride ate a whole ox and eight salmon, and drank three barrels of mead."
        },
        {
          "es": "Nunca vi comer así a una novia, dijo Thrym. Loki respondió: ocho noches sin comer, de tanta ansiedad.",
          "en": "Never saw a bride eat so much, said Thrym. Loki answered: eight nights without food, so eager was she."
        },
        {
          "es": "Thrym levantó el velo para besarla y saltó hacia atrás: ¿por qué los ojos de Freyja arden como fuego?",
          "en": "Thrym lifted the veil to kiss her, and jumped back: why do Freyja's eyes burn like fire?"
        },
        {
          "es": "Loki, rápido como siempre: ocho noches sin dormir, de tanta ansiedad.",
          "en": "Loki, quick as ever: eight nights without sleep, so eager was she."
        }
      ],
