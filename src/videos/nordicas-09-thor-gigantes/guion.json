      "frases": [
        {
          "es": "Por fin Thrym ordenó: traigan el martillo para bendecir a la novia.",
          "en": "At last Thrym ordered: bring the hammer to bless the bride."
        },
        {
          "es": "Cuando Thor sintió a Mjölnir en sus manos, su corazón rio de alegría.",
          "en": "When Thor felt Mjolnir in his hands, his heart laughed."
        },
        {
          "es": "Se arrancó el velo y golpeó primero a Thrym, y luego a todos los gigantes del banquete.",
          "en": "He tore off the veil and struck Thrym first, then every giant at the feast."
        },
        {
          "es": "Por eso el trueno retumba en el cielo cuando Thor blande su martillo.",
          "en": "That is why thunder rolls across the sky whenever Thor swings his hammer."
        }
