      "frases": [
        {
          "es": "En Jötunheim, el gigante Thrym trenzaba correas de oro para sus perros.",
          "en": "In Jotunheim, the giant Thrym sat braiding golden leashes for his dogs."
        },
        {
          "es": "Loki aterrizó ante él. Thrym sonrió: sé a qué vienes. Yo tengo el martillo de Thor.",
          "en": "Loki landed before him. Thrym smiled: I know why you came. I have Thor's hammer."
        },
        {
          "es": "Lo enterré ocho leguas bajo tierra. No lo verán jamás, a menos que Freyja sea mi esposa.",
          "en": "I buried it eight leagues deep. You will not see it again, unless Freyja becomes my wife."
        },
        {
          "es": "Loki voló de regreso a toda velocidad para llevar la exigencia a los dioses.",
          "en": "Loki flew back at full speed to carry the demand to the gods."
        }
