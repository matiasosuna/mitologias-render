      "frases": [
        {
          "es": "Skrymir caminó con ellos. Thor lo golpeó dormido, pero el gigante solo preguntó si había caído una hoja.",
          "en": "Skrymir walked with them. Thor struck him in his sleep, but he only asked if a leaf had fallen."
        },
        {
          "es": "Skrymir les advirtió: en Útgarðr viven hombres mucho más grandes que yo. No presuman allí.",
          "en": "Skrymir warned them: in Utgard live men far bigger than I. Do not boast there."
        },
        {
          "es": "Pronto vieron una fortaleza tan alta que tuvieron que echar la cabeza atrás para ver su cima.",
          "en": "Soon they saw a fortress so high they had to tip back their heads to see its top."
        },
        {
          "es": "El rey, Útgarða-Loki, se rio: aquí solo se queda quien domina un arte. ¿Qué saben hacer?",
          "en": "The king, Utgarda-Loki, laughed: here, only those who master some art may stay. What can you do?"
        }
