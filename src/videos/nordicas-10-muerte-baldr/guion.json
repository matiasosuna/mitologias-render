      },
      "frases": [
        {
          "es": "Hodr tomó el dardo y, guiado por Loki, lo arrojó con todas sus fuerzas.",
          "en": "Hodr took the dart and, guided by Loki, hurled it with all his strength."
        },
        {
          "es": "El dardo alcanzó a Baldr, y el más amado de los dioses cayó muerto.",
          "en": "The dart struck Baldr, and the most beloved of the gods fell dead."
        },
        {
          "es": "Los dioses quedaron mudos. Miraron a Loki, pero ese lugar era sagrado y no podían vengarse allí.",
          "en": "The gods fell silent. They looked at Loki, but the place was sacred and they could not take revenge there."
        },
        {
          "es": "Entonces estalló el llanto. Nunca habían sufrido una desgracia así.",
          "en": "Then the weeping broke out. They had never suffered a misfortune like it."
        }
      ],
