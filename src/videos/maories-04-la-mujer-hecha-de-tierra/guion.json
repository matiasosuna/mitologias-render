      "frases": [
        {
          "es": "Hine-tītama creció hermosa y brillante como la mañana.",
          "en": "Hine-tītama grew up beautiful, as bright as the morning."
        },
        {
          "es": "Cuando fue grande, Tāne también la tomó como esposa.",
          "en": "When she was grown, Tāne took her as his wife too."
        },
        {
          "es": "Ella no sabía que él era su padre.",
          "en": "She did not know that he was her father."
        },
        {
          "es": "Vivieron juntos, y tuvieron hijos.",
          "en": "They lived together, and they had children."
        },
        {
          "es": "Pero el secreto de Tāne no podía quedar escondido para siempre.",
          "en": "But Tāne's secret could not stay hidden forever."
        }
