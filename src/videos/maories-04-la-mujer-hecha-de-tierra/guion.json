          1.05
        ]
      },
      "frases": [
        {
          "es": "Con sus manos, le dio forma a un cuerpo de arcilla roja.",
          "en": "With his hands, he shaped a body out of the red clay."
        },
        {
          "es": "Le hizo cabeza, brazos, piernas y una cara.",
          "en": "He made a head, arms, legs, and a face."
        },
        {
          "es": "Trabajó con cuidado, como un tallador con su madera.",
          "en": "He worked with great care, like a carver with his wood."
        },
        {
          "es": "Parecía una mujer. Pero no se movía. No respiraba.",
          "en": "It looked like a woman. But it did not move. It did not breathe."
        },
        {
          "es": "Tāne se sentó a su lado y miró su obra. Faltaba algo: la vida.",
          "en": "Tāne sat beside her and looked at his work. One thing was missing: life."
        }
      ],
