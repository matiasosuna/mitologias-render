      "frases": [
        {
          "es": "Ella era Hine-ahu-one: la doncella hecha de tierra.",
          "en": "She was Hine-ahu-one: the maiden formed from earth."
        },
        {
          "es": "En esta versión, fue la primera mujer.",
          "en": "In this telling, she was the very first woman."
        },
        {
          "es": "Tāne la tomó como esposa, y tuvieron una hija.",
          "en": "Tāne took her as his wife, and they had a daughter."
        },
        {
          "es": "La llamaron Hine-tītama, la doncella del amanecer.",
          "en": "They named her Hine-tītama, the dawn maiden."
        },
        {
          "es": "Al nacer ella, el cielo del este se puso rosado y dorado.",
          "en": "As she was born, the eastern sky turned pink and gold."
        }
      ],
