      },
      "frases": [
        {
          "es": "Papatūānuku le dijo: «Ve a Kurawaka, y hazla de tierra».",
          "en": "Papatūānuku told him: 'Go to Kurawaka, and shape her out of the earth.'"
        },
        {
          "es": "Kurawaka era un lugar donde la tierra era roja.",
          "en": "Kurawaka was a place where the soil was red."
        },
        {
          "es": "Tāne fue hasta allí y se arrodilló sobre la tierra roja.",
          "en": "Tāne went there, and knelt down on the red earth."
        },
        {
          "es": "Tomó la arcilla entre sus manos. Estaba tibia y blanda.",
          "en": "He took the clay in his hands. It was warm and soft."
        },
        {
          "es": "Papatūānuku la miraba en silencio, como una madre que espera.",
          "en": "Papatūānuku watched him in silence, like a mother waiting."
        }
      ],
