   "frases": [
    {
     "es": "Tras las cinco edades, la humanidad llegó a la edad de hierro, y su maldad ya no tenía límites.",
     "en": "After the five ages, humanity reached the Iron Age, and its wickedness knew no limits."
    },
    {
     "es": "Mentían, robaban y peleaban entre hermanos; nadie respetaba a los huéspedes ni a los dioses.",
     "en": "They lied, they stole, and brothers fought brothers; no one honored guests or the gods."
    },
    {
     "es": "Desde el Olimpo, Zeus escuchaba los rumores y decidió comprobarlos con sus propios ojos.",
     "en": "From Olympus, Zeus heard the rumors and decided to see the truth with his own eyes."
    },
    {
     "es": "Se quitó su forma divina y bajó a la tierra disfrazado de viajero humilde.",
     "en": "He cast off his divine form and walked the earth disguised as a humble traveler."
    }
