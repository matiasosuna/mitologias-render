   "frases": [
    {
     "es": "Fueron al templo de Temis, la diosa de la justicia, y le pidieron ayuda.",
     "en": "They went to the temple of Themis, goddess of justice, and begged for her help."
    },
    {
     "es": "La diosa respondió: cúbranse la cabeza y arrojen detrás de ustedes los huesos de su gran madre.",
     "en": "The goddess replied: cover your heads and throw the bones of your great mother behind you."
    },
    {
     "es": "Pirra se asustó: nunca ofendería a su madre de esa manera.",
     "en": "Pyrrha was horrified: she would never insult her mother that way."
    },
    {
     "es": "Pero Deucalión entendió: la gran madre es la Tierra, y sus huesos son las piedras.",
     "en": "But Deucalion understood: the great mother is Earth, and her bones are stones."
    }
