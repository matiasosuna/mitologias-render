   "frases": [
    {
     "es": "De regreso en el Olimpo, Zeus reunió a los dioses.",
     "en": "Back on Olympus, Zeus gathered the gods."
    },
    {
     "es": "Licaón no era el único: toda la humanidad se había corrompido, y debía desaparecer.",
     "en": "Lycaon was not alone: all of humanity had become corrupt, and had to vanish."
    },
    {
     "es": "Tomó su rayo para incendiar la tierra, pero se detuvo.",
     "en": "He took up his thunderbolt to set the earth ablaze, but he stopped."
    },
    {
     "es": "Un fuego tan grande podía alcanzar el cielo y quemar también la casa de los dioses.",
     "en": "A fire so vast could reach the heavens and burn the home of the gods as well."
    },
    {
     "es": "Entonces eligió otro castigo: el agua.",
     "en": "So he chose another punishment: water."
    }
