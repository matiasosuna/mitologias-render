      "frases": [
        {
          "en": "Zeus was furious and overturned the table. A thunderbolt struck the palace.",
          "es": "Zeus, furioso, volcó la mesa. Un rayo cayó sobre el palacio."
        },
        {
          "en": "Lycaon fled into the fields. He tried to scream, but only howls came out.",
          "es": "Licaón huyó por los campos. Quiso gritar, pero solo le salían aullidos."
        },
        {
          "en": "His clothes turned into gray fur, and his arms became paws.",
          "es": "Su ropa se volvió pelo gris y sus brazos se hicieron patas."
        },
        {
          "en": "The cruel king had become a wolf, with the same fierce eyes as before.",
          "es": "El rey cruel se había vuelto lobo, con la misma mirada feroz de siempre."
        }
      ],
