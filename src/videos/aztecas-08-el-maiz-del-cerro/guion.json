      "frases": [
        {
          "es": "Entonces Oxomoco y Cipactónal, la primera pareja, echaron suertes con granos de maíz.",
          "en": "Then Oxomoco and Cipactonal, the first couple, cast lots with kernels of maize."
        },
        {
          "es": "Ellos sabían leer el calendario y las señales. Por eso los dioses les preguntaron a ellos.",
          "en": "They knew how to read the calendar and the signs. That is why the gods asked them."
        },
        {
          "es": "Los granos dijeron: \"Solo Nanahuatzin puede abrir el cerro.\"",
          "en": "The kernels said: \"Only Nanahuatzin can break the mountain open.\""
        },
        {
          "es": "Nanahuatzin era un dios humilde y enfermo, con la piel llena de llagas.",
          "en": "Nanahuatzin was a humble, sickly god, his skin covered in sores."
        }
