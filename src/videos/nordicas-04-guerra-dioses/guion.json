      "frases": [
        {
          "es": "Los Æsir vivían en Asgard, la fortaleza de los dioses, protegida por una gran muralla.",
          "en": "The Æsir lived in Asgard, the fortress of the gods, guarded by a great wall."
        },
        {
          "es": "Allí reinaba Odín, padre de los dioses, junto a su esposa Frigg.",
          "en": "There ruled Odin, father of the gods, alongside his wife Frigg."
        },
        {
          "es": "Thor, el dios del trueno, defendía a dioses y a humanos con su martillo.",
          "en": "Thor, the god of thunder, defended gods and humans with his hammer."
        },
        {
          "es": "Y Tyr era el más valiente de todos: nunca retrocedía ante el peligro.",
          "en": "And Tyr was the bravest of them all: he never backed away from danger."
        },
        {
          "es": "Eran los dioses de la guerra, de la sabiduría y de la justicia.",
          "en": "They were the gods of war, of wisdom, and of justice."
        }
      ],
