      "frases": [
        {
          "es": "Los Vanir vivían en Vanaheim, y eran dioses de la tierra fértil, de las cosechas y de la magia.",
          "en": "The Vanir lived in Vanaheim, and they were gods of fertile land, of harvests, and of magic."
        },
        {
          "es": "Njord dominaba el viento y el mar, y los marineros lo invocaban antes de zarpar.",
          "en": "Njord ruled the wind and the sea, and sailors called on him before setting out."
        },
        {
          "es": "Su hijo Freyr traía la lluvia y el sol que hacen crecer los campos.",
          "en": "His son Freyr brought the rain and the sunshine that make the fields grow."
        },
        {
          "es": "Y su hija Freyja conocía el seiðr, una magia antigua que ve lo que está por venir.",
          "en": "And his daughter Freyja knew seiðr, an ancient magic that sees what is yet to come."
        },
        {
          "es": "Los Æsir tenían la espada y el martillo. Los Vanir, la magia y la tierra.",
          "en": "The Æsir had the sword and the hammer. The Vanir had magic and the land."
        }
      ],
