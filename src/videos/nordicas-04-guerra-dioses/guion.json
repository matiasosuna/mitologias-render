      "frases": [
        {
          "es": "Heimdall seguía de guardia en Bifröst, el puente que une Asgard con los demás mundos.",
          "en": "Heimdall still stood guard on Bifröst, the bridge that joins Asgard to the other worlds."
        },
        {
          "es": "Desde allí se veía el hogar de los dioses, muy alto, en el cielo.",
          "en": "From there you could see the home of the gods, high up in the sky."
        },
        {
          "es": "Pero los dioses de Asgard no eran los únicos del mundo.",
          "en": "But the gods of Asgard were not the only gods in the world."
        },
        {
          "es": "Había dos familias de dioses, y durante mucho tiempo vivieron separadas.",
          "en": "There were two families of gods, and for a long time they lived apart."
        },
        {
          "es": "Hasta que un día, la paz entre ellas se rompió.",
          "en": "Until one day, the peace between them was broken."
        }
      ],
