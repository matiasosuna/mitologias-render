      "frases": [
        {
          "es": "Los Vanir marcharon contra Asgard con un gran ejército.",
          "en": "The Vanir marched on Asgard with a great army."
        },
        {
          "es": "Odín tomó su lanza y la arrojó por encima de los enemigos.",
          "en": "Odin took his spear and hurled it over the heads of the enemy."
        },
        {
          "es": "Así empezó el primer combate de la historia: la primera guerra del mundo.",
          "en": "And so began the first battle in history: the first war in the world."
        },
        {
          "es": "Las lanzas cruzaron el campo, y el cielo se llenó de gritos.",
          "en": "Spears flew across the field, and the sky filled with cries."
        },
        {
          "es": "Y dioses que nunca habían luchado empezaron a arrasar las tierras unos de otros.",
          "en": "And gods who had never fought began to ravage each other's lands."
        }
      ],
