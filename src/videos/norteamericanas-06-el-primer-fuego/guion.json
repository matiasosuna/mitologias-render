      "sinAstros": true,
      "frases": [
        {
          "es": "Hiló un hilo de su propio cuerpo y lo tejió en un cuenquito, llamado tusti.",
          "en": "She spun a thread from her own body, and wove it into a little bowl, called a tusti."
        },
        {
          "es": "Se ató el cuenco a la espalda y corrió sobre el agua hasta la isla.",
          "en": "She tied the bowl on her back, and ran across the water to the island."
        },
        {
          "es": "Puso una brasita de fuego en el cuenco, y la llevó todo el camino de vuelta.",
          "en": "She put one little coal of fire into her bowl, and carried it all the way back."
        },
        {
          "es": "Y desde entonces tenemos fuego.",
          "en": "And ever since, we have had fire."
        }
