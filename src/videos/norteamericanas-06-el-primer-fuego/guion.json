      "frases": [
        {
          "es": "Los animales hicieron un consejo. ¿Quién podía cruzar el agua y traer el fuego?",
          "en": "The animals held a council. Who could cross the water and bring back the fire?"
        },
        {
          "es": "Todos los animales que podían volar o nadar querían ir.",
          "en": "Every animal that could fly or swim wanted to go."
        },
        {
          "es": "Primero se ofreció el Cuervo. Era grande y fuerte, así que lo mandaron.",
          "en": "The Raven offered first. He was big and strong, so they sent him."
        }
