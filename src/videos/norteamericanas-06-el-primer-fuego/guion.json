      "frases": [
        {
          "es": "Voló alto y lejos sobre el agua, y se posó en el árbol en llamas.",
          "en": "He flew high and far across the water, and landed on the burning tree."
        },
        {
          "es": "Mientras pensaba qué hacer, el calor le chamuscó todas las plumas hasta dejarlas negras.",
          "en": "While he was wondering what to do, the heat scorched all his feathers black."
        },
        {
          "es": "Se asustó y volvió a casa sin el fuego.",
          "en": "He was frightened, and he flew home without the fire."
        }
      ],
