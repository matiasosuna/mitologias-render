      "frases": [
        {
          "es": "Entonces los Truenos, que vivían allá arriba, mandaron su rayo.",
          "en": "Then the Thunders, who lived up above, sent down their lightning."
        },
        {
          "es": "Cayó en un sicomoro hueco que crecía en una isla.",
          "en": "It struck a hollow sycamore tree that grew on an island."
        },
        {
          "es": "El fuego empezó a arder dentro del árbol. Por arriba salía humo.",
          "en": "Fire began to burn deep inside the tree. Smoke rose out of the top."
        },
        {
          "es": "Los animales veían el humo. Pero la isla estaba lejos, del otro lado del agua.",
          "en": "The animals could see the smoke. But the island was far away, across the water."
        }
      ],
