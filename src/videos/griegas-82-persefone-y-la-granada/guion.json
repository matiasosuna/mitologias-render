      "frases": [
        {
          "es": "Al décimo día, Deméter fue a ver a Helios, el dios del sol, que lo ve todo desde el cielo.",
          "en": "On the tenth day, Demeter went to Helios, the sun god, who sees everything from the sky."
        },
        {
          "es": "Helios sintió pena por ella y le dijo la verdad.",
          "en": "Helios felt sorry for her, and he told her the truth."
        },
        {
          "es": "Hades se había llevado a Perséfone, y Zeus lo había permitido.",
          "en": "Hades had taken Persephone, and Zeus had allowed it."
        },
        {
          "es": "Deméter quedó destrozada. Y estaba furiosa con Zeus.",
          "en": "Demeter was crushed with grief. And she was furious with Zeus."
        },
        {
          "es": "Dejó el Olimpo y caminó entre los humanos, disfrazada de anciana.",
          "en": "She left Olympus and walked among humans, disguised as an old woman."
        }
