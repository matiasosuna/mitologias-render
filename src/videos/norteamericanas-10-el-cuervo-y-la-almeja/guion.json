      "frases": [
        {
          "es": "Entonces oyó un sonidito que salía de la arena, a sus pies.",
          "en": "Then he heard a tiny sound, coming from the sand at his feet."
        },
        {
          "es": "Era una almeja gigante, un poco abierta.",
          "en": "It was a giant clamshell, partly open."
        },
        {
          "es": "El Cuervo se acercó. Unas caritas lo espiaban desde adentro.",
          "en": "Raven leaned in close. Little faces were peeking out at him."
        },
        {
          "es": "Adentro había unas criaturas pequeñas, con mucho miedo del gran mundo de afuera.",
          "en": "Inside were small creatures, very afraid of the big world outside."
        }
      ],
