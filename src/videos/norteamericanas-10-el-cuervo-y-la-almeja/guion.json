      "frases": [
        {
          "es": "El Cuervo tenía curiosidad. Quería ver qué harían.",
          "en": "Raven was curious. He wanted to see what they would do."
        },
        {
          "es": "Así que les habló con su voz suave y dulce de embaucador.",
          "en": "So he spoke to them in his smooth, sweet trickster's voice."
        },
        {
          "es": "'Salgan', les dijo. 'Salgan a ver mi mundo maravilloso.'",
          "en": "'Come out,' he said. 'Come out and see my wonderful world.'"
        },
        {
          "es": "Al principio, nadie se movió.",
          "en": "At first, no one moved."
        }
      ],
