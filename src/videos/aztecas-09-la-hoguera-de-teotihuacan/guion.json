      "frases": [
        {
          "es": "Durante cuatro días, los dos se prepararon con ayunos y ofrendas.",
          "en": "For four days, the two of them prepared, fasting and making offerings."
        },
        {
          "es": "Tecciztécatl ofreció plumas de quetzal, bolas de oro y piedras preciosas.",
          "en": "Tecciztecatl offered quetzal feathers, balls of gold, and precious stones."
        },
        {
          "es": "Nanahuatzin ofreció cañas verdes y ramas de pino. Era todo lo que tenía.",
          "en": "Nanahuatzin offered green reeds and pine branches. It was all he had."
        },
        {
          "es": "Cada uno ayunó sobre un cerro. Los mexicas decían que esos cerros son las Pirámides del Sol y de la Luna.",
          "en": "Each fasted on a hill of his own. The Mexica said those hills are the Pyramids of the Sun and the Moon."
        }
      ],
