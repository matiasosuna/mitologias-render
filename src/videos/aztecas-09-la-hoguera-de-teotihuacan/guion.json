      "frases": [
        {
          "es": "Detrás de ellos entraron un águila y un jaguar.",
          "en": "After them, an eagle and a jaguar went in."
        },
        {
          "es": "El águila se chamuscó: por eso sus plumas son oscuras.",
          "en": "The eagle was singed: that is why its feathers are dark."
        },
        {
          "es": "El jaguar entró cuando el fuego ya bajaba, y quedó manchado: por eso tiene manchas negras.",
          "en": "The jaguar went in as the fire was dying down, and got smudged: that is why it has black spots."
        },
        {
          "es": "Desde entonces, los guerreros más valientes de los mexicas se llamaron Águilas y Jaguares.",
          "en": "Ever since, the bravest Mexica warriors were called Eagles and Jaguars."
        }
      ],
