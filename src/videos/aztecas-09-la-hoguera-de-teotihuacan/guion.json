      "frases": [
        {
          "es": "Tecciztécatl corrió hacia la hoguera. Pero el calor era terrible, y se detuvo.",
          "en": "Tecciztecatl ran toward the bonfire. But the heat was terrible, and he stopped."
        },
        {
          "es": "Lo intentó cuatro veces. Las cuatro veces tuvo miedo y se echó para atrás.",
          "en": "He tried four times. All four times, he was afraid and pulled back."
        },
        {
          "es": "Los dioses lo miraban en silencio.",
          "en": "The gods watched him in silence."
        }
      ],
