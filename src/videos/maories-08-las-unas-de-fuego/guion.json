      "frases": [
        {
          "es": "Mahuika se arrancó una uña de la mano. Y de esa uña salió fuego.",
          "en": "Mahuika pulled out one of her fingernails. And from that nail, fire flowed."
        },
        {
          "es": "Se la dio a Māui: una llamita viva.",
          "en": "She gave it to Māui: a small, living flame."
        },
        {
          "es": "Māui se alejó un poco… y la apagó. Del todo.",
          "en": "Māui walked a little way off… and put it out. Completely."
        },
        {
          "es": "Volvió y dijo: «La luz que me diste se apagó. ¿Me das otra?»",
          "en": "Then he went back and said: 'The light you gave me has gone out. Could I have another?'"
        }
      ],
