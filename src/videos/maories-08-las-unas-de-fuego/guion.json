          1.05
        ]
      },
      "frases": [
        {
          "es": "A la mañana, Māui gritó: «¡Tengo hambre! ¡Rápido, cocinen algo para mí!»",
          "en": "In the morning, Māui shouted: 'I'm hungry! Quick, cook some food for me!'"
        },
        {
          "es": "Los sirvientes corrieron a encender el fuego. Pero no quedaba ni una brasa.",
          "en": "The servants ran to light the fire. But there was not a single ember left."
        },
        {
          "es": "Su madre, Taranga, dijo: «Vayan a ver a Mahuika, nuestra antepasada. Ella guarda el fuego.»",
          "en": "His mother, Taranga, said: 'Go to Mahuika, our ancestress. She is the keeper of fire.'"
        },
        {
          "es": "Pero los sirvientes tenían miedo, y nadie quiso ir.",
          "en": "But the servants were afraid, and nobody would go."
        },
        {
          "es": "Entonces Māui dijo: «Yo iré. Yo traeré fuego para la gente.»",
          "en": "So Māui said: 'I will go. I will fetch fire for the people.'"
        }
      ],
