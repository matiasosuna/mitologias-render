      },
      "frases": [
        {
          "es": "Sus padres le mostraron el camino: un sendero ancho, que había que seguir hasta el final.",
          "en": "His parents showed him the way: a broad path that he must follow to the very end."
        },
        {
          "es": "«Cuando ella te pregunte quién eres, dile tu nombre. Así sabrá que eres de su familia.»",
          "en": "'When she asks who you are, tell her your name. Then she will know you are her own family.'"
        },
        {
          "es": "«Y ten cuidado. No le hagas ninguna de tus travesuras.»",
          "en": "'And be careful. Do not play any of your tricks on her.'"
        },
        {
          "es": "Māui les dijo que solo quería fuego para la gente. Y se fue por el camino.",
          "en": "Māui told them he only wanted fire for the people. And off he went down the path."
        }
      ],
