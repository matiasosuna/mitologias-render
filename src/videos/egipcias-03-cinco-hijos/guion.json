      "frases": [
        {
          "es": "El segundo día nació Horus el Viejo, con cabeza de halcón, y echó a volar hacia el cielo.",
          "en": "On the second day, Horus the Elder was born, falcon-headed, and flew into the sky."
        },
        {
          "es": "Los egipcios decían que su ojo derecho era el sol y su ojo izquierdo, la luna.",
          "en": "The Egyptians said his right eye was the sun, his left eye the moon."
        },
        {
          "es": "Era el halcón que cruza el cielo de un horizonte al otro y lo ve todo desde arriba.",
          "en": "He was the falcon who crosses the sky from horizon to horizon, seeing everything."
        },
        {
          "es": "Se le llama el Viejo porque más tarde nacería otro Horus, hijo de Osiris.",
          "en": "He is called the Elder because a later Horus would be a son of Osiris."
        }
      ],
