      "frases": [
        {
          "es": "El segundo día nació Horus el Viejo, con cabeza de halcón, y alzó el vuelo hacia el cielo.",
          "en": "On the second day Horus the Elder was born, falcon-headed, and he took flight into the sky."
        },
        {
          "es": "Los egipcios decían que su ojo derecho era el sol, y su ojo izquierdo, la luna.",
          "en": "The Egyptians said his right eye was the sun, and his left eye was the moon."
        },
        {
          "es": "Era el halcón que cruza el cielo de un horizonte al otro, y desde arriba lo ve todo.",
          "en": "He was the falcon who crosses the sky from one horizon to the other, seeing everything from above."
        },
        {
          "es": "Lo llamaban el Viejo para no confundirlo con otro Horus, hijo de Osiris, que nacería mucho después.",
          "en": "They called him the Elder so no one would mix him up with another Horus, a son of Osiris, who would be born much later."
        }
      ],
