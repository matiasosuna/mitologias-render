      "frases": [
        {
          "es": "Odín había visto el futuro, y lo que vio lo llenó de miedo.",
          "en": "Odin had seen the future, and what he saw filled him with fear."
        },
        {
          "es": "Pero un dios no puede vivir asustado, y Asgard tenía un problema más urgente.",
          "en": "But a god cannot live in fear, and Asgard had a more urgent problem."
        },
        {
          "es": "Desde la guerra con los Vanir, la muralla de los dioses seguía en ruinas.",
          "en": "Ever since the war with the Vanir, the wall of the gods had lain in ruins."
        },
        {
          "es": "Y Thor, su mejor defensor, estaba lejos, en el este, luchando contra los trolls.",
          "en": "And Thor, their best defender, was far away in the east, fighting trolls."
        },
        {
          "es": "Cualquier gigante podía entrar en Asgard. Y los gigantes no habían olvidado lo que Odín le hizo a Ymir.",
          "en": "Any giant could walk into Asgard. And the giants had not forgotten what Odin did to Ymir."
        }
      ],
