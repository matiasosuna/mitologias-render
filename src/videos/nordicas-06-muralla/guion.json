      "frases": [
        {
          "es": "Los dioses nórdicos vivían en Asgard, su ciudad. Odín era el jefe de los dioses.",
          "en": "The Norse gods lived in Asgard, their city. Odin was the chief of the gods."
        },
        {
          "es": "Asgard tenía un problema: su muralla estaba en ruinas desde la guerra contra los Vanir.",
          "en": "Asgard had a problem: its wall had been in ruins since the war with the Vanir, another family of gods."
        },
        {
          "es": "Sin muralla, los gigantes, enemigos de los dioses, podían entrar cuando quisieran.",
          "en": "Without a wall, the giants, who were enemies of the gods, could walk in whenever they wanted."
        },
        {
          "es": "Y Thor, el dios del trueno y mejor defensor de Asgard, estaba lejos, en el este, peleando contra trolls.",
          "en": "And Thor, the thunder god and the best defender of Asgard, was far away in the east, fighting trolls."
        },
        {
          "es": "Los dioses necesitaban una muralla nueva, y llegó alguien que se ofreció a construirla.",
          "en": "The gods needed a new wall, and someone came who offered to build it."
        }
      ],
