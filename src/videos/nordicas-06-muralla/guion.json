      "frases": [
        {
          "es": "Pasaron los meses, y Loki seguía sin aparecer.",
          "en": "Months went by, and Loki was nowhere to be seen."
        },
        {
          "es": "Hasta que un día volvió a Asgard, porque Loki había dado a luz a un potro.",
          "en": "Until one day he returned to Asgard, because Loki had given birth to a foal."
        },
        {
          "es": "Un potro gris, con ocho patas: Sleipnir, hijo de Loki y de Svaðilfari.",
          "en": "A gray foal with eight legs: Sleipnir, the child of Loki and Svaðilfari."
        },
        {
          "es": "Por eso el caballo de Odín tiene ocho patas: es hijo de Loki.",
          "en": "That is why Odin's horse has eight legs: he is Loki's child."
        },
        {
          "es": "Sería el mejor caballo entre los dioses y los hombres.",
          "en": "He would be the best horse among gods and men."
        },
        {
          "es": "Loki se lo regaló a Odín, que lo montó desde entonces por los nueve mundos.",
          "en": "Loki gave him to Odin, who rode him from then on through all the nine worlds."
        }
