      "frases": [
        {
          "es": "La lava corrió detrás de Kamapuaʻa. Él se volvió pasto y cubrió un campo entero.",
          "en": "The lava chased Kamapuaʻa. He turned himself into grass and covered a whole field."
        },
        {
          "es": "Por un rato, el pasto desvió la lava. Pero después empezó a arder.",
          "en": "For a while, the grass turned the lava aside. But then it began to burn."
        },
        {
          "es": "Kamapuaʻa volvió a ser hombre, con las cerdas chamuscadas.",
          "en": "Kamapuaʻa became a man again, his bristles singed."
        },
        {
          "es": "Por eso, dicen, los cerdos casi no tienen pelo en la panza.",
          "en": "And that, they say, is why pigs have so little hair on their bellies."
        }
      ],
