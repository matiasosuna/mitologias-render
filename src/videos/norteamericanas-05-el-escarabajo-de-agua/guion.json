      "frases": [
        {
          "es": "Hace mucho tiempo, todo el mundo era agua. No había tierra en ninguna parte.",
          "en": "Long ago, the whole world was water. There was no land anywhere."
        },
        {
          "es": "Muy arriba, más allá de una gran bóveda de piedra en el cielo, había un lugar que los cherokee llaman Galunlati.",
          "en": "High above, beyond a great arch of stone in the sky, was a place the Cherokee call Galunlati."
        },
        {
          "es": "Todos los animales vivían allí arriba. Pero estaban muy apretados y querían más lugar.",
          "en": "All the animals lived up there. But it was very crowded, and they wanted more room."
        },
        {
          "es": "Miraron el agua allá abajo y se preguntaron: ¿qué habrá ahí debajo?",
          "en": "They looked down at the water and wondered: what is under there?"
        }
      ],
