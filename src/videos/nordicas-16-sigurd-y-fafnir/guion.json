      },
      "frases": [
        {
          "es": "Regin le habló a Sigurd de Fáfnir y su oro. Mata al dragón, le dijo, y el tesoro es tuyo.",
          "en": "Regin told Sigurd about Fafnir and his gold. Kill the dragon, he said, and the treasure is yours."
        },
        {
          "es": "Hazme una espada, dijo Sigurd. Regin hizo dos espadas, pero cada una se rompió contra el yunque.",
          "en": "Make me a sword, said Sigurd. Regin made two swords, but each one broke on the anvil."
        },
        {
          "es": "Sigurd fue a ver a su madre. Ella había guardado los pedazos de la espada de su padre.",
          "en": "Sigurd went to his mother. She had kept the pieces of his father's sword."
        },
        {
          "es": "Regin forjó los pedazos en una hoja nueva. Parecía que le corrían llamas por los filos.",
          "en": "Regin forged the pieces into a new blade. Flames seemed to run along its edges."
        },
        {
          "es": "Esta era Gram. Sigurd golpeó el yunque, y Gram lo partió en dos.",
          "en": "This was Gram. Sigurd struck the anvil, and Gram split it in two."
        },
        {
          "es": "En el río, un mechón de lana flotó contra la hoja. Gram lo cortó en dos.",
          "en": "In the river, a tuft of wool floated against the blade. Gram cut it in two."
        }
      ],
