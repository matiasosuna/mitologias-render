      "frases": [
        {
          "es": "Osiris tenía un hermano: Set, el señor del desierto y de las tormentas.",
          "en": "Osiris had a brother: Set, lord of the desert and the storms."
        },
        {
          "es": "Set veía cómo todos querían a Osiris, y por dentro se le agriaba el corazón.",
          "en": "Set watched everyone love Osiris, and inside him his heart turned sour."
        },
        {
          "es": "Quería el trono de su hermano. Y cuando Osiris volvió de su viaje, empezó a reunir aliados en secreto.",
          "en": "He wanted his brother’s throne. And when Osiris came home from his travels, Set began gathering allies in secret."
        },
        {
          "es": "Setenta y dos hombres se unieron a su conjura, y también una reina del sur llamada Aso.",
          "en": "Seventy-two men joined his plot, and so did a queen from the south named Aso."
        }
      ],
