      "frases": [
        {
          "es": "Le quedaba perfecto, como si el cofre se hubiera hecho para él. Y así era.",
          "en": "It fit him perfectly, as if the chest had been made for him. And it had."
        },
        {
          "es": "En ese instante, los conjurados corrieron y cerraron la tapa de un golpe.",
          "en": "In that instant the conspirators rushed forward and slammed the lid shut."
        },
        {
          "es": "La clavaron con clavos y la sellaron con plomo fundido, para que nunca más pudiera abrirse.",
          "en": "They nailed it down and sealed it with molten lead, so it could never be opened again."
        },
        {
          "es": "La fiesta, que había empezado con risas, terminó en silencio.",
          "en": "The feast that had begun with laughter ended in silence."
        }
      ],
