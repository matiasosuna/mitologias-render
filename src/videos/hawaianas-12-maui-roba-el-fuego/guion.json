      },
      "frases": [
        {
          "es": "Pero Māui seguía enojado. La madre ʻalae lo había engañado una y otra vez.",
          "en": "But Māui was still angry. The mother ʻalae had fooled him again and again."
        },
        {
          "es": "Tomó un palo encendido y se lo pasó por la frente al ave.",
          "en": "He picked up a burning stick and rubbed it across the bird's forehead."
        },
        {
          "es": "Las plumas de ahí se quemaron, y la piel se puso de un rojo vivo.",
          "en": "The feathers there burned away, and the skin turned bright red."
        },
        {
          "es": "Por eso la ʻalae tiene la frente roja, hasta hoy.",
          "en": "That is why the ʻalae has a red forehead, even today."
        },
        {
          "es": "¿Ella hizo bien en engañarlo, o él tenía razón en enojarse?",
          "en": "Was she right to trick him, or was he right to be angry?"
        }
      ],
