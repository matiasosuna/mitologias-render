      "frases": [
        {
          "es": "Zeus era el rey de los dioses. Había vencido a los antiguos dioses gigantes, los Titanes.",
          "en": "Zeus was the king of the gods. He had beaten the old giant gods, the Titans."
        },
        {
          "es": "Dos Titanes no habían luchado contra él: Prometeo y su hermano Epimeteo.",
          "en": "Two Titans had not fought against him: Prometheus and his brother Epimetheus."
        },
        {
          "es": "Prometeo era astuto y siempre pensaba antes.",
          "en": "Prometheus was clever and always thought ahead."
        },
        {
          "es": "Epimeteo actuaba primero y pensaba después.",
          "en": "Epimetheus acted first and thought later."
        },
        {
          "es": "Los dioses les dieron un trabajo: llenar la tierra de seres vivos.",
          "en": "The gods gave them a job: to fill the earth with living creatures."
        }
