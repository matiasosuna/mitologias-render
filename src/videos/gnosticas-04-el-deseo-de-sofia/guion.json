        {
          "en": 0.2,
          "texto": {
            "es": "UN PODER INVENCIBLE",
            "en": "AN UNCONQUERABLE POWER"
          },
          "x": 960,
          "y": 200,
          "hasta": 2
        }
      ],
      "frases": [
        {
          "en": "There was a power in her that no one can defeat.",
          "es": "Había en ella un poder que nadie puede vencer."
        },
        {
          "en": "Because of that power, her thought did not stay idle.",
          "es": "Por ese poder, su pensamiento no quedó quieto."
        },
        {
          "en": "Her thought became real, and something came out of her.",
          "es": "Su pensamiento se hizo real, y algo salió de ella."
        },
        {
          "en": "So Sophia brought forth, alone.",
          "es": "Así Sofía dio a luz, sola."
        }
      ]
