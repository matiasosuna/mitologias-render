      ],
      "frases": [
        {
          "en": "The Savior had told John about the four great lights, and the aeons who stand with them.",
          "es": "El Salvador le había contado a Juan de las cuatro grandes luces y de los eones que están con ellas."
        },
        {
          "en": "The last of all the aeons was Sophia, by the fourth light, Eleleth.",
          "es": "El último de todos los eones era Sofía, junto a la cuarta luz, Eleleth."
        },
        {
          "en": "She is called the Sophia of the Epinoia: the Wisdom of the shining Insight.",
          "es": "Se la llama la Sofía de la Epinoia: la Sabiduría de la Intuición luminosa."
        },
        {
          "en": "Now the Savior told John what Sophia did, and what came out of it.",
          "es": "Ahora el Salvador le contó a Juan lo que hizo Sofía, y lo que salió de eso."
        }
      ]
