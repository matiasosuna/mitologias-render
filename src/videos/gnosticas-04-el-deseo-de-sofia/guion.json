          },
          "x": 960,
          "y": 200
        }
      ],
      "frases": [
        {
          "en": "What came out of her was not perfect.",
          "es": "Lo que salió de ella no era perfecto."
        },
        {
          "en": "It was different from her. It did not look like her at all.",
          "es": "Era distinto de ella. No se parecía a ella en nada."
        },
        {
          "en": "This was because she had made it without her partner.",
          "es": "Eso era porque lo había hecho sin su pareja."
        },
        {
          "en": "It did not have the likeness of its mother. It had another form.",
          "es": "No tenía la semejanza de su madre. Tenía otra forma."
        }
      ]
