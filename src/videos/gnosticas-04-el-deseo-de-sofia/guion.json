          "texto": {
            "es": "PARA QUE NINGÚN INMORTAL LO VIERA",
            "en": "SO THAT NO IMMORTAL WOULD SEE IT"
          },
          "x": 960,
          "y": 200
        }
      ],
      "frases": [
        {
          "en": "Sophia cast it away from her.",
          "es": "Sofía lo echó lejos de ella."
        },
        {
          "en": "She threw it out, far outside the places of the aeons.",
          "es": "Lo arrojó afuera, lejos de los lugares de los eones."
        },
        {
          "en": "She did not want any of the immortal ones to see it.",
          "es": "No quería que ninguno de los inmortales lo viera."
        },
        {
          "en": "For she had made it in ignorance, without knowing.",
          "es": "Porque lo había hecho en la ignorancia, sin saber."
        }
      ]
