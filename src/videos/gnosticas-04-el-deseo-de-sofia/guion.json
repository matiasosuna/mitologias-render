      "rotulos": [
        {
          "en": 0.2,
          "texto": {
            "es": "SIN EL CONSENTIMIENTO DEL ESPÍRITU",
            "en": "WITHOUT THE CONSENT OF THE SPIRIT"
          },
          "x": 960,
          "y": 200,
          "hasta": 3
        }
      ],
      "frases": [
        {
          "en": "But the Spirit had not agreed. He had not given his consent.",
          "es": "Pero el Espíritu no había aceptado. No había dado su consentimiento."
        },
        {
          "en": "Her partner had not agreed either. He had not thought it over with her.",
          "es": "Su pareja tampoco había aceptado. No lo había pensado con ella."
        },
        {
          "en": "She had not found the one who agrees with her.",
          "es": "Ella no había encontrado al que está de acuerdo con ella."
        },
        {
          "en": "She thought it alone, without the consent of the Spirit, and without her partner knowing.",
          "es": "Lo pensó sola, sin el consentimiento del Espíritu y sin que su pareja lo supiera."
        },
        {
          "en": "And still, she brought it forth.",
          "es": "Y aun así, lo dio a luz."
        }
      ]
