      "frases": [
        {
          "es": "La pareja tuvo cuatro hijos. Los cuatro serían dioses muy poderosos.",
          "en": "The couple had four sons. All four would become mighty gods."
        },
        {
          "es": "El primero fue Tezcatlipoca Rojo, al que también llamaban Camaxtli.",
          "en": "The first was Red Tezcatlipoca, who was also called Camaxtli."
        },
        {
          "es": "El segundo fue Tezcatlipoca Negro, el más grande y el más temido de los cuatro.",
          "en": "The second was Black Tezcatlipoca, the greatest and the most feared of the four."
        },
        {
          "es": "Su nombre quiere decir Espejo Humeante. En muchas versiones, su espejo podía ver todo lo que pasaba.",
          "en": "His name means Smoking Mirror. In many tellings, his mirror could see everything that happened."
        }
      ],
