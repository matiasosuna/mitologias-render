      "frases": [
        {
          "es": "Se encontró con una mujer que sostenía una calabaza llena de agua.",
          "en": "He met a woman who was holding a gourd full of water."
        },
        {
          "es": "«Dame un trago de tu calabaza», dijo, «y empujaré los cielos más arriba».",
          "en": "“Give me a drink from your gourd,” he said, “and I will push the heavens higher.”"
        },
        {
          "es": "La mujer le pasó la calabaza. Māui bebió largamente.",
          "en": "The woman handed him the gourd. Māui drank deeply."
        },
        {
          "es": "Luego se apoyó contra las nubes.",
          "en": "Then he braced himself against the clouds."
        },
        {
          "es": "Él era pequeño y el cielo era enorme. ¿Se movería?",
          "en": "He was small, and the sky was huge. Would it move?"
        }
      ],
