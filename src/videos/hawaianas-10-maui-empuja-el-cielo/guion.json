      },
      "frases": [
        {
          "es": "Māui empujó con todas sus fuerzas. Las nubes temblaron.",
          "en": "Māui pushed with all his strength. The clouds shook."
        },
        {
          "es": "El cielo subió hasta la altura de los árboles.",
          "en": "The sky rose to the height of the trees."
        },
        {
          "es": "Empujó otra vez y subió hasta las cimas de las montañas.",
          "en": "He pushed again, and it climbed to the tops of the mountains."
        },
        {
          "es": "Una vez más, con un empujón enorme, lo llevó hasta donde está hoy.",
          "en": "Once more, with a mighty heave, he pressed it up to where it is today."
        },
        {
          "es": "¿Le habrías dado tu agua a un extraño que prometía levantar el cielo?",
          "en": "Would you have given your water to a stranger who promised to lift the sky?"
        }
