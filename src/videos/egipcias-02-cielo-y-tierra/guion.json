        ]
      },
      "frases": [
        {
          "es": "Geb y Nut, la tierra y el cielo, seguían abrazados sin soltarse.",
          "en": "Geb and Nut, the earth and the sky, were still locked in their embrace."
        },
        {
          "es": "Estaban tan apretados que entre los dos no cabía ni un soplo de aire ni un rayo de luz.",
          "en": "They were pressed so close that there was no room between them for a breath of air or a ray of light."
        },
        {
          "es": "Sin un hueco entre ellos, el mundo no tenía dónde existir: ni días, ni plantas, ni viento.",
          "en": "With no gap between them, the world had nowhere to exist: no days, no plants, no wind."
        },
        {
          "es": "Y su padre, Shu, el aire, no tenía ni dónde estar.",
          "en": "And their father, Shu, the god of air, had nowhere to stand."
        }
      ],
