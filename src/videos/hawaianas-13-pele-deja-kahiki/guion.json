      "frases": [
        {
          "es": "Kamohoaliʻi preparó una gran canoa doble. Se llamaba Honuaiākea.",
          "en": "Kamohoaliʻi made ready a great double canoe. Its name was Honuaiākea."
        },
        {
          "es": "Subieron hermanos y hermanas: Kāneʻapua, Kānemilohai y muchos más.",
          "en": "Brothers and sisters climbed aboard: Kāneʻapua, Kānemilohai, and many more."
        },
        {
          "es": "Pele llevaba el huevo contra su pecho y, en la mano, un palo mágico de cavar llamado Paoa.",
          "en": "Pele held the egg to her chest, and in her hand, a magic digging stick called Paoa."
        },
        {
          "es": "Kamohoaliʻi iba al timón. Era el mejor piloto del océano.",
          "en": "Kamohoaliʻi steered. He was the finest pilot on the ocean."
        },
        {
          "es": "Navegaron hacia el norte, día tras día, sobre las olas.",
          "en": "They sailed north, day after day, over the waves."
        },
        {
          "es": "Y muy atrás, desde el mar, Nāmaka los vigilaba.",
          "en": "And far behind them, from the sea, Nāmaka was watching."
        }
