      "frases": [
        {
          "es": "Pele pasaba los días sentada junto al fogón de su madre.",
          "en": "Pele spent her days sitting by her mother's fireplace."
        },
        {
          "es": "Allí trabajaba Lonomakua, el guardián del fuego.",
          "en": "There worked Lonomakua, the keeper of the fire."
        },
        {
          "es": "Pele miraba todo lo que él hacía: cómo encendía la llama y cómo la mantenía viva.",
          "en": "Pele watched everything he did: how he lit the flame, and how he kept it alive."
        },
        {
          "es": "No era un juego. Era su escuela.",
          "en": "It was not a game. It was her school."
        },
        {
          "es": "Pele estaba aprendiendo a ser la reina del fuego.",
          "en": "Pele was learning to become the queen of fire."
        }
