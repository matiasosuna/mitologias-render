      "frases": [
        {
          "es": "Y entonces, al amanecer, todo se detiene.",
          "en": "And then, at dawn, everything stops."
        },
        {
          "es": "Esto es Nyepi, el Día del Silencio, el primer día del año nuevo balinés.",
          "en": "This is Nyepi, the Day of Silence, the first day of the Balinese new year."
        },
        {
          "es": "Ese calendario cuenta los años desde la era Saka, que empezó en el año 78.",
          "en": "That calendar counts its years from the Saka era, which began in the year 78."
        },
        {
          "es": "Nada de fuego ni de luces. Nada de trabajo. Nada de viajes. Nada de diversión.",
          "en": "No fires and no lights. No work. No travel. No entertainment."
        },
        {
          "es": "Durante veinticuatro horas, hasta el aeropuerto internacional cierra.",
          "en": "For twenty-four hours, even the international airport closes."
        }
      ],
