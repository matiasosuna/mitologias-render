      },
      "frases": [
        {
          "es": "Hiʻiaka creció en Puna, la tierra de lava y bosques del este de la isla.",
          "en": "Hiʻiaka grew up in Puna, the land of lava and forests on the east side of the island."
        },
        {
          "es": "Su lugar favorito eran los bosques de ʻōhiʻa lehua, árboles con flores rojas como plumas.",
          "en": "Her favorite place was the forests of ʻōhiʻa lehua, trees with red flowers like feathers."
        },
        {
          "es": "Uno de esos bosques era suyo. Lo cuidaba como un jardín.",
          "en": "One of those forests was her own. She cared for it like a garden."
        },
        {
          "es": "Juntaba las flores rojas y hacía con ellas guirnaldas, los lei.",
          "en": "She gathered the red flowers and wove them into garlands, called lei."
        },
        {
          "es": "Los pájaros del bosque venían a tomar el néctar de las flores.",
          "en": "Forest birds came to drink the sweet nectar of the flowers."
        },
        {
          "es": "Para Hiʻiaka, ese bosque era el lugar más lindo del mundo.",
          "en": "For Hiʻiaka, that forest was the loveliest place in the world."
        }
      ],
