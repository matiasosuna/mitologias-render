   "frases": [
    {
     "es": "Mientras tanto, algo se movía en la carne de Ymir, que ahora era la tierra.",
     "en": "Meanwhile, something was moving in Ymir's flesh, which was now the earth."
    },
    {
     "es": "Eran gusanos, como los que crecen en un cuerpo muerto.",
     "en": "They were maggots, like the ones that grow in a dead body."
    },
    {
     "es": "Los dioses les dieron forma de hombres y una mente lista.",
     "en": "The gods gave them the shape of men and a clever mind."
    },
    {
     "es": "Son los enanos. Viven bajo la tierra y entre las rocas, lejos del sol.",
     "en": "These are the dwarves. They live under the earth and among rocks, far from the sun."
    }
   ],
