   "frases": [
    {
     "es": "El cielo seguía oscuro. Pero las chispas del mundo de fuego aún volaban por el vacío.",
     "en": "The sky was still dark. But sparks from the world of fire were still flying through the gap."
    },
    {
     "es": "Los hermanos tomaron las chispas brillantes, una por una.",
     "en": "The brothers took the glowing sparks, one by one."
    },
    {
     "es": "Las pusieron en el cielo, para dar luz al cielo y a la tierra.",
     "en": "They set them in the sky, to give light to the heavens and the earth."
    },
    {
     "es": "Así nacieron las estrellas.",
     "en": "That is how the stars were born."
    }
   ],
