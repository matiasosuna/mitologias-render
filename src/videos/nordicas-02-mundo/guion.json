   "frases": [
    {
     "es": "Odín, jefe de los dioses, y sus hermanos Vili y Ve habían matado a Ymir, el primer gigante.",
     "en": "Odin, chief of the gods, and his brothers Vili and Ve had killed Ymir, the first giant."
    },
    {
     "es": "No había tierra, ni madera, ni piedra. Solo estaba el enorme cuerpo de Ymir.",
     "en": "There was no earth, no wood and no stone. There was only Ymir's huge body."
    },
    {
     "es": "Así que los hermanos decidieron construir un mundo con él.",
     "en": "So the brothers decided to build a world from it."
    }
   ],
