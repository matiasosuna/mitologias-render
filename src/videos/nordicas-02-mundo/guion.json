    {
     "es": "De la carne de Ymir hicieron la tierra.",
     "en": "From Ymir's flesh they made the earth."
    },
    {
     "es": "De su sangre hicieron el mar y los lagos.",
     "en": "From his blood they made the sea and the lakes."
    },
    {
     "es": "De su pelo hicieron los árboles y los bosques.",
     "en": "From his hair they made the trees and forests."
    },
    {
     "es": "De sus huesos hicieron las montañas.",
     "en": "From his bones they made the mountains."
    },
    {
     "es": "De sus dientes y huesos rotos hicieron las piedras y las rocas.",
     "en": "From his teeth and broken bones they made the stones and rocks."
    }
