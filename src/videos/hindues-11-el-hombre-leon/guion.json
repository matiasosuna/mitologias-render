      "frases": [
        {
          "es": "Su hermano, Hiranyakashipu, juró vengarse de Vishnu.",
          "en": "His brother, Hiranyakashipu, swore revenge on Vishnu."
        },
        {
          "es": "Se fue a una montaña e hizo una penitencia terrible: de puntillas, con los brazos en alto, sin comer.",
          "en": "He went to a mountain and did terrible penance: standing on his toes, arms raised, eating nothing."
        },
        {
          "es": "El Bhagavata Purana dice que las hormigas hicieron su hormiguero sobre él, y aun así no se movió.",
          "en": "The Bhagavata Purana says ants built their hill over his body, and still he did not move."
        },
        {
          "es": "Al final, Brahma apareció y le ofreció un deseo.",
          "en": "At last, Brahma appeared and offered him a wish."
        }
      ],
