      },
      "frases": [
        {
          "es": "Una tarde, el rey gritó: \"¿Dónde está tu Vishnu? Dices que está en todas partes\".",
          "en": "One evening, the king shouted: \"Where is your Vishnu? You say he is everywhere.\""
        },
        {
          "es": "\"¿Está en esta columna?\" \"Sí\", dijo Prahlada. \"Está\".",
          "en": "\"Is he in this pillar?\" \"Yes,\" said Prahlada. \"He is.\""
        },
        {
          "es": "El rey golpeó la columna con el puño.",
          "en": "The king struck the pillar with his fist."
        },
        {
          "es": "La columna se partió con un rugido terrible.",
          "en": "The pillar cracked open with a terrible roar."
        },
        {
          "es": "De ella salió Vishnu, en una forma nunca vista: Narasimha, mitad hombre y mitad león.",
          "en": "Out of it came Vishnu, in a form no one had ever seen: Narasimha, half man and half lion."
        }
      ],
