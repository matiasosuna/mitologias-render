      "frases": [
        {
          "es": "Hiranyakashipu pidió no morir a manos de ningún hombre ni de ninguna bestia.",
          "en": "Hiranyakashipu asked never to be killed by any man or any beast."
        },
        {
          "es": "Ni de día ni de noche. Ni dentro de una casa ni fuera de ella.",
          "en": "Not by day, and not by night. Not inside a house, and not outside."
        },
        {
          "es": "Ni en la tierra ni en el cielo. Y con ningún arma.",
          "en": "Not on the ground, not in the sky. And not with any weapon."
        },
        {
          "es": "Brahma se lo concedió. Ahora creía que nadie podría matarlo jamás.",
          "en": "Brahma granted it. Now he believed that no one could ever kill him."
        }
      ],
