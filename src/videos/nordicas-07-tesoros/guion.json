      "frases": [
        {
          "es": "Loki acababa de regalarle a Odín a Sleipnir, el extraño caballo de ocho patas, y los dioses estaban contentos.",
          "en": "Loki had just given Odin his strange eight-legged horse, Sleipnir, and the gods were pleased."
        },
        {
          "es": "Pero Loki nunca se quedaba mucho tiempo sin causar problemas, y esta vez empezó con una broma.",
          "en": "But Loki never stayed out of trouble for long, and this time it began with a joke."
        },
        {
          "es": "Sif, la esposa de Thor, era famosa por su cabello largo, que brillaba como un campo de trigo dorado.",
          "en": "Sif, the wife of Thor, was famous for her long hair, which shone like a field of golden wheat."
        }
      ],
