      "frases": [
        {
          "es": "Thor ardía de furia. Atrapó a Loki y lo sujetó con sus enormes manos.",
          "en": "Thor burned with fury. He seized Loki and gripped him in his enormous hands."
        },
        {
          "es": "Juró romperle todos los huesos del cuerpo.",
          "en": "He swore to break every bone in his body."
        },
        {
          "es": "Loki suplicó, y prometió traerle a Sif cabello de oro verdadero, que crecería como el suyo.",
          "en": "Loki begged, and promised to bring Sif hair of true gold, which would grow like her own."
        },
        {
          "es": "¿Cómo?, preguntó Thor. Los enanos de Svartalfheim, dijo Loki. Ellos pueden forjar cualquier cosa.",
          "en": "How? asked Thor. The dwarves of Svartalfheim, said Loki. They can forge anything."
        }
      ],
