      "frases": [
        {
          "es": "Una noche, Sif dormía, y Loki entró en su cuarto sin hacer ruido.",
          "en": "One night Sif lay asleep, and Loki crept into her room without a sound."
        },
        {
          "es": "Solo por travesura, y sin ninguna razón, le cortó todo el cabello dorado hasta la raíz.",
          "en": "Just for mischief, and for no reason at all, he cut off all her golden hair down to the roots."
        },
        {
          "es": "Cuando Sif despertó y se vio la cabeza pelada, se cubrió y lloró.",
          "en": "When Sif woke and found her head bare, she covered it and wept."
        },
        {
          "es": "Thor volvió a casa, vio a su esposa, y supo enseguida quién lo había hecho.",
          "en": "Thor came home, saw his wife, and knew at once who had done it."
        }
