      "frases": [
        {
          "es": "La Mujer del Cielo estaba al borde de un hoyo en el cielo. Muy abajo solo veía agua.",
          "en": "Sky Woman stood at the edge of a hole in the sky. Far below, she saw only water."
        },
        {
          "es": "Y cayó.",
          "en": "Then she fell."
        },
        {
          "es": "Unas versiones dicen que se resbaló. Otras, que su esposo la empujó.",
          "en": "Some tellings say she slipped. Others say her husband pushed her."
        },
        {
          "es": "Al caer, sus manos agarraron raíces y semillas del Mundo del Cielo.",
          "en": "As she fell, her hands closed around roots and seeds from the Sky World."
        }
      ],
