      "frases": [
        {
          "es": "Los ojos del bebé eran muy brillantes y se movían rápido.",
          "en": "The baby's eyes were very bright, and they moved around quickly."
        },
        {
          "es": "Su abuelo lo quería muchísimo.",
          "en": "His grandfather loved him very much."
        },
        {
          "es": "El bebé gateaba por la casa, llorando y llorando, y señalando los bultos.",
          "en": "The baby crawled around the house, crying and crying, and pointing at the bundles."
        },
        {
          "es": "'Denle lo que pide', dijo el abuelo. 'Denle la bolsa de las estrellas.'",
          "en": "'Give him what he is crying for,' said the grandfather. 'Give him the bag of stars.'"
        }
      ],
