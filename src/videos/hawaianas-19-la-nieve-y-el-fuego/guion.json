      "frases": [
        {
          "es": "Allí vivían cuatro doncellas del manto blanco, las diosas de las montañas nevadas.",
          "en": "There lived four maidens of the white mantle, the goddesses of the snowy mountains."
        },
        {
          "es": "Lilinoe, la diosa de la niebla fina, también ligada a Haleakalā.",
          "en": "Lilinoe, the goddess of the fine mist, also linked to Haleakalā."
        },
        {
          "es": "Waiau, la del lago que brilla en la cumbre de Mauna Kea.",
          "en": "Waiau, the goddess of the lake that shines on the summit of Mauna Kea."
        },
        {
          "es": "Kahoupokane, la de las nieves de Hualālai.",
          "en": "Kahoupokane, the goddess of the snows of Hualālai."
        },
        {
          "es": "Y la más famosa de todas: Poliʻahu, la diosa de la nieve de Mauna Kea.",
          "en": "And the most famous of all: Poliʻahu, the snow goddess of Mauna Kea."
        }
