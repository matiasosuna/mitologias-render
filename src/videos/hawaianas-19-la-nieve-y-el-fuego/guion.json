      "frases": [
        {
          "es": "Poliʻahu amaba los acantilados de Hāmākua, donde las cascadas caen al mar.",
          "en": "Poliʻahu loved the cliffs of Hāmākua, where waterfalls drop into the sea."
        },
        {
          "es": "Allí se sentaba sobre una roca, con su manto de kapa blanca.",
          "en": "There she would sit on a rock, in her mantle of white kapa cloth."
        },
        {
          "es": "Ese manto era de nieve. Donde ella iba, llegaba el frío.",
          "en": "That mantle was made of snow. Wherever she went, the cold came with her."
        },
        {
          "es": "Pero también podía sacárselo, y ponerse un vestido hecho de sol dorado.",
          "en": "But she could also take it off, and put on a dress made of golden sunshine."
        },
        {
          "es": "Le gustaba bajar a encontrarse con los jefes y jugar a sus juegos de destreza.",
          "en": "She liked to come down to meet the chiefs, and to play their games of skill."
        }
      ],
