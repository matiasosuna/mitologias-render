      "frases": [
        {
          "es": "El padre de Sati era Daksha, un hijo de Brahma, el creador.",
          "en": "Sati's father was Daksha, a son of Brahma, the creator."
        },
        {
          "es": "Daksha era un señor poderoso, uno de los padres de todas las criaturas. Y era muy orgulloso.",
          "en": "Daksha was a mighty lord, one of the fathers of all creatures. And he was very proud."
        },
        {
          "es": "Sati amaba a Shiva con todo el corazón. El Shiva Purana dice que rezó y ayunó para ganarlo.",
          "en": "Sati loved Shiva with all her heart. The Shiva Purana says she prayed and fasted to win him."
        },
        {
          "es": "Así, Sati se casó con Shiva, el yogui de las montañas, cubierto de ceniza.",
          "en": "And so Sati married Shiva, the yogi of the mountains, covered in ash."
        },
        {
          "es": "A Daksha nunca le gustó. Un ermitaño salvaje no es esposo para mi hija, pensaba.",
          "en": "Daksha never liked him. A wild hermit is no husband for my daughter, he thought."
        }
      ],
