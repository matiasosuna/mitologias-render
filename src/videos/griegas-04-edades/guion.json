      "frases": [
        {
          "es": "Los griegos contaban una historia sobre cinco edades de la humanidad, una tras otra.",
          "en": "The Greeks told a story about five ages of humans, one after another."
        },
        {
          "es": "El poeta Hesíodo la cantó en su poema Trabajos y días.",
          "en": "The poet Hesiod sang it in his poem Works and Days."
        },
        {
          "es": "Cada edad era una raza distinta de personas, hecha por los dioses.",
          "en": "Each age was a different race of people, made by the gods."
        },
        {
          "es": "Las edades fueron: oro, plata, bronce, héroes y hierro.",
          "en": "The ages were gold, silver, bronze, heroes and iron."
        },
        {
          "es": "Casi cada edad fue peor que la anterior.",
          "en": "Almost every age was worse than the one before."
        }
