      "frases": [
        {
          "es": "Cuando llegaba la muerte, se dormían en paz, como en un sueño.",
          "en": "When death came, they fell asleep in peace, as if in a dream."
        },
        {
          "es": "Entonces Zeus, rey de los dioses, convirtió a esa raza en espíritus bondadosos.",
          "en": "Then Zeus, king of the gods, turned that race into kindly spirits."
        },
        {
          "es": "Desde entonces recorren el mundo envueltos en niebla, sin ser vistos.",
          "en": "Ever since, they roam the world wrapped in mist, unseen."
        },
        {
          "es": "Cuidan a las personas, protegen a los justos y reparten riqueza.",
          "en": "They watch over people, protect the just, and give wealth."
        }
