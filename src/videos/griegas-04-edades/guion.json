   "frases": [
    {
     "es": "Cuando les llegaba la muerte, se dormían en paz, como vencidos por un sueño.",
     "en": "When death came, they fell asleep in peace, as if overcome by a dream."
    },
    {
     "es": "Y cuando la tierra cubrió a esa raza, Zeus los convirtió en espíritus buenos.",
     "en": "And when the earth covered that race, Zeus turned them into kindly spirits."
    },
    {
     "es": "Desde entonces recorren el mundo envueltos en niebla, invisibles.",
     "en": "Ever since, they roam the world wrapped in mist, unseen."
    },
    {
     "es": "Vigilan a los mortales, protegen a los justos y reparten riqueza.",
     "en": "They watch over mortals, protect the just, and hand out wealth."
    }
