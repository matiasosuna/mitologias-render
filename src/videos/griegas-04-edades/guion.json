   "frases": [
    {
     "es": "Los dioses crearon la primera raza cuando Cronos todavía reinaba en el cielo.",
     "en": "The gods made the first race while Cronus still ruled the heavens."
    },
    {
     "es": "Era una raza de oro, y sus hombres vivían como dioses, sin preocupaciones ni dolor.",
     "en": "It was a golden race, and its people lived like gods, free of worry and pain."
    },
    {
     "es": "No tenían que trabajar: la tierra les daba frutos por sí sola, en abundancia.",
     "en": "They never had to work: the earth gave fruit by itself, in abundance."
    },
    {
     "es": "Era una primavera eterna, sin leyes ni castigos, porque nadie hacía el mal.",
     "en": "It was an eternal spring, with no laws or punishments, because no one did wrong."
    },
    {
     "es": "No conocían la vejez, y pasaban los días en fiestas y banquetes.",
     "en": "They never grew old, and spent their days in feasts and banquets."
    }
   ],
