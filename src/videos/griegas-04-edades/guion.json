   "frases": [
    {
     "es": "Zeus creó entonces una tercera raza, de bronce, nacida de los fresnos.",
     "en": "Zeus then made a third race, of bronze, born from ash trees."
    },
    {
     "es": "Eran terribles y fuertes, con brazos invencibles y corazones duros como el metal.",
     "en": "They were fierce and strong, with unbeatable arms and hearts as hard as metal."
    },
    {
     "es": "Sus armas eran de bronce, sus casas eran de bronce, porque todavía no existía el hierro.",
     "en": "Their weapons were bronze, their houses were bronze, for iron did not exist yet."
    },
    {
     "es": "No comían pan: lo único que les importaba era la guerra.",
     "en": "They ate no bread: war was all they cared about."
    },
    {
     "es": "Y se destruyeron entre ellos, con sus propias manos.",
     "en": "And they destroyed each other, with their own hands."
    },
    {
     "es": "Bajaron sin nombre al frío reino de Hades, y nadie los recuerda.",
     "en": "They went down nameless to the cold realm of Hades, and no one remembers them."
    }
   ],
