      "frases": [
        {
          "es": "Zeus hizo entonces una tercera raza, de bronce, nacida de los fresnos.",
          "en": "Zeus then made a third race, of bronze, born from ash trees."
        },
        {
          "es": "Eran feroces y fuertes, con corazones duros como el metal.",
          "en": "They were fierce and strong, with hearts as hard as metal."
        },
        {
          "es": "Sus armas y sus casas eran de bronce, porque el hierro aún no existía.",
          "en": "Their weapons and houses were bronze, because iron did not exist yet."
        },
        {
          "es": "No comían pan. Solo les importaba la guerra.",
          "en": "They ate no bread. War was all they cared about."
        },
        {
          "es": "Se destruyeron entre ellos con sus propias manos.",
          "en": "They destroyed each other with their own hands."
        },
        {
          "es": "Bajaron sin nombre al Hades, el reino de los muertos, y nadie los recuerda.",
          "en": "They went down nameless to Hades, the realm of the dead. No one remembers them."
        }
      ],
