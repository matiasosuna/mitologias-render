      "frases": [
        {
          "es": "Luego vino la quinta raza, la raza de hierro. Es la nuestra.",
          "en": "Then came the fifth race, the race of iron. This is our own race."
        },
        {
          "es": "El poeta Hesíodo deseaba haber nacido en otra edad.",
          "en": "The poet Hesiod wished he had been born in another age."
        },
        {
          "es": "La gente de hierro nunca descansa del trabajo y el cansancio, de día ni de noche.",
          "en": "Iron people never rest from work and weariness, by day or by night."
        },
        {
          "es": "Los dioses les mandan duras penas, aunque algo de bien se mezcla con el mal.",
          "en": "The gods send them harsh troubles, though some good is still mixed with the evil."
        },
        {
          "es": "Cavaron la tierra en busca de hierro y oro, y nació la guerra.",
          "en": "People dug the earth for iron and gold, and war was born."
        }
