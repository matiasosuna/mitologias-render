      "frases": [
        {
          "es": "Amón era el dios del aire, el viento invisible que se siente pero no se ve.",
          "en": "Amun was the god of the air, the wind you feel but cannot see."
        },
        {
          "es": "En un himno antiguo se dice que es más oculto que los demás dioses.",
          "en": "An old hymn says he is more hidden than the other gods."
        },
        {
          "es": "Los egipcios creían que podía estar en todas partes a la vez.",
          "en": "The Egyptians believed he could be everywhere at once."
        },
        {
          "es": "Por eso rezaban a él los pobres y también los reyes.",
          "en": "So both poor people and kings prayed to him."
        }
      ],
