      "frases": [
        {
          "es": "Al principio, Tebas era una ciudad pequeña, y Amón un dios local.",
          "en": "At first, Thebes was a small city, and Amun a local god."
        },
        {
          "es": "Pero hace unos 4000 años, reyes de Tebas gobernaron todo Egipto.",
          "en": "But about 4,000 years ago, kings from Thebes ruled all of Egypt."
        },
        {
          "es": "Sus nombres llevaban el de Amón, como Amenemhat, 'Amón está al frente'.",
          "en": "Their names carried his name, like Amenemhat, 'Amun is at the front'."
        },
        {
          "es": "Cuando la ciudad creció, creció también su dios.",
          "en": "As the city grew, so did its god."
        }
      ],
