      },
      "frases": [
        {
          "es": "Una vez al año, en la fiesta de Opet, la estatua de Amón salía de Karnak.",
          "en": "Once a year, at the Opet Festival, Amun's statue left Karnak."
        },
        {
          "es": "Los sacerdotes la llevaban en una barca sagrada, tapada con telas.",
          "en": "Priests carried it in a sacred boat, covered with cloth."
        },
        {
          "es": "Cruzaban Tebas hacia el templo de Luxor, y la gente bailaba y cantaba.",
          "en": "They crossed Thebes toward Luxor Temple while people danced and sang."
        },
        {
          "es": "El pueblo podía acercarse a su dios, aunque no lo viera.",
          "en": "For a moment, the people could come close to their god, even if they could not see him."
        }
