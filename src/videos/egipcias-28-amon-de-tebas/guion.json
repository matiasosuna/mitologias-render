      "frases": [
        {
          "es": "Tebas fue una gran ciudad del sur de Egipto, junto al Nilo. Allí reinaba Amón.",
          "en": "Thebes was a great city in the south of Egypt, on the Nile. There, Amun was king of the gods."
        },
        {
          "es": "Su nombre significa 'el oculto'. Nadie podía ver su verdadera forma.",
          "en": "His name means 'the hidden one'. No one could see his true form."
        },
        {
          "es": "Se lo dibuja con piel azul y una corona de dos plumas altas.",
          "en": "He is drawn with blue skin and a crown of two tall feathers."
        },
        {
          "es": "El azul era el color del cielo y del aire, que no se pueden tocar.",
          "en": "Blue was the color of the sky and the air, which no one can touch."
        }
      ],
