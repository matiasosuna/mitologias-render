      "frases": [
        {
          "es": "En el mar, Kupe dijo que el ancla se había trabado en el fondo.",
          "en": "Out on the water, Kupe said that the anchor was stuck on the bottom."
        },
        {
          "es": "Le pidió a Hoturapa que se tirara al agua a soltarla.",
          "en": "He asked Hoturapa to dive down and free it."
        },
        {
          "es": "Mientras Hoturapa estaba bajo el agua, Kupe se fue remando.",
          "en": "While Hoturapa was under the water, Kupe paddled away."
        },
        {
          "es": "Hoturapa nunca volvió a subir.",
          "en": "Hoturapa never came back up."
        },
        {
          "es": "Entonces Kupe tomó a Kuramārōtini como esposa, y partieron juntos en su gran canoa, Matahourua.",
          "en": "Then Kupe took Kuramārōtini as his wife, and they set out together in his great canoe, Matahourua."
        }
