      "frases": [
        {
          "es": "Navegaron muchos días y muchas noches por el gran océano.",
          "en": "They sailed for many days and nights across the great ocean."
        },
        {
          "es": "El océano era tan ancho que no se veía tierra por ningún lado.",
          "en": "The ocean was so wide that no land could be seen in any direction."
        },
        {
          "es": "De día, Kupe leía las olas y los vientos.",
          "en": "By day, Kupe read the waves and the winds."
        },
        {
          "es": "De noche, se guiaba por las estrellas.",
          "en": "By night, he steered by the stars."
        },
        {
          "es": "Cada estrella que salía en el horizonte le mostraba el camino.",
          "en": "Each star rising on the horizon showed him the way."
        },
        {
          "es": "Kuramārōtini miraba el cielo con él, buscando tierra.",
          "en": "Kuramārōtini watched the sky with him, looking for land."
        }
      ],
