      "frases": [
        {
          "es": "Rangda significa 'viuda'. Es la reina de los leak, las brujas de las historias balinesas.",
          "en": "Rangda means 'widow'. She is the queen of the leak, the witches of Balinese stories."
        },
        {
          "es": "Su máscara tiene ojos saltones, colmillos largos y una lengua que cuelga como una llama.",
          "en": "Her mask has bulging eyes, long fangs, and a tongue that hangs down like a flame."
        },
        {
          "es": "Su pelo blanco le cae hasta el suelo, y tiene uñas largas y curvas.",
          "en": "Her white hair falls to the ground, and her fingernails are long and curved."
        },
        {
          "es": "En la mano lleva un paño blanco, lleno de magia.",
          "en": "In her hand she holds a white cloth, full of magic."
        }
