      "frases": [
        {
          "es": "«¡Eres demasiado pequeña!», se rieron los animales de la Rata Almizclera.",
          "en": "“You are too small!” the animals laughed at the Muskrat."
        },
        {
          "es": "Tres grandes nadadores ya habían fallado en llegar al fondo.",
          "en": "Three great swimmers had already failed to reach the bottom."
        },
        {
          "es": "La Mujer del Cielo seguía sin tierra para sus semillas.",
          "en": "Sky Woman still had no earth for her seeds."
        },
        {
          "es": "La Rata Almizclera respiró hondo y se zambulló.",
          "en": "The Muskrat took a deep breath and dove."
        }
