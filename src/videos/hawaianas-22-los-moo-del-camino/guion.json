      },
      "frases": [
        {
          "es": "Hiʻiaka siguió por la costa de Hawaiʻi, venciendo moʻo y tiburones, y cruzó el mar hasta Maui.",
          "en": "Hiʻiaka went on along the coast of Hawaiʻi, defeating moʻo and sharks, and crossed the sea to Maui."
        },
        {
          "es": "En Molokaʻi, una moʻo llamada Kikipua estiraba la lengua sobre el agua, como un puente falso.",
          "en": "On Molokaʻi, a moʻo named Kikipua stretched her tongue over the water, like a false bridge."
        },
        {
          "es": "Los viajeros que la pisaban se caían y no volvían.",
          "en": "Travelers who stepped on it fell in and never came back."
        },
        {
          "es": "Hiʻiaka la venció, y tendió su propia falda como puente. Así cruzaron sin peligro.",
          "en": "Hiʻiaka defeated her, and laid down her own skirt as a bridge. So they crossed safely."
        }
      ],
