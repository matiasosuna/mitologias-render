      "frases": [
        {
          "es": "Los haudenosaunee son el Pueblo de la Casa Larga: seis naciones en lo que hoy es Nueva York y Canadá.",
          "en": "The Haudenosaunee are the People of the Longhouse: six nations in what is now New York State and Canada."
        },
        {
          "es": "Su historia más antigua empieza muy arriba, en un mundo más allá del cielo.",
          "en": "Their oldest story begins far above our heads, in a world beyond the sky."
        },
        {
          "es": "Los narradores suelen contarla en invierno, cuando las noches son largas y el fuego calienta.",
          "en": "Storytellers often share it in winter, when the nights are long and the fire is warm."
        },
        {
          "es": "Cada narrador la cuenta un poco distinta. Esta es una de esas maneras.",
          "en": "Every teller tells it a little differently. This is one of those ways."
        }
