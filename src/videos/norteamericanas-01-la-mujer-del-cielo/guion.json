      "frases": [
        {
          "es": "Cayó y cayó, fuera del Mundo del Cielo, entre nubes y viento.",
          "en": "Down she fell, out of the Sky World, through the clouds and the wind."
        },
        {
          "es": "Abajo no había tierra, ni árboles, ni rocas. Solo la gran agua.",
          "en": "Below her, there was no earth, no trees, no rocks. Only the great water."
        },
        {
          "es": "Pero el agua no estaba vacía. En ella nadaban animales y sobre ella volaban aves.",
          "en": "But the water was not empty. Animals swam in it, and birds flew over it."
        },
        {
          "es": "Y algunos miraron hacia arriba, y vieron a una mujer cayendo del cielo.",
          "en": "And some of them looked up, and saw a woman falling from the sky."
        }
      ],
