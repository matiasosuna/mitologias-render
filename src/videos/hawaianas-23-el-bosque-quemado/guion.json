      "frases": [
        {
          "es": "Al amanecer, Hiʻiaka y Wahineʻōmaʻo subieron por el acantilado, bajo una tormenta.",
          "en": "At dawn, Hiʻiaka and Wahineʻōmaʻo climbed the cliff, in a storm."
        },
        {
          "es": "Las moʻo les tiraron lluvias de piedras desde arriba.",
          "en": "The moʻo women hurled showers of stones down on them."
        },
        {
          "es": "Una piedra grande golpeó a Hiʻiaka en el pecho, y cayó del acantilado.",
          "en": "A big stone struck Hiʻiaka in the chest, and she fell from the cliff."
        },
        {
          "es": "Pero se levantó. Y volvió a subir.",
          "en": "But she got up. And she climbed again."
        }
      ],
