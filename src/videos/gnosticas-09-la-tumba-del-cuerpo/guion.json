      "frases": [
        {
          "en": "This is the tomb: the newly shaped body.",
          "es": "Esta es la tumba: el cuerpo recién formado."
        },
        {
          "en": "The robbers dressed the man in it, like a garment.",
          "es": "Los ladrones vistieron al hombre con él, como con una ropa."
        },
        {
          "en": "It is the chain of forgetting.",
          "es": "Es la cadena del olvido."
        },
        {
          "en": "And Adam became a man who dies.",
          "es": "Y Adán se volvió un hombre que muere."
        }
