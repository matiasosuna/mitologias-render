      "frases": [
        {
          "es": "Pele vio venir al mar. Y no quiso esconderse más.",
          "en": "Pele saw the sea coming. And she did not want to hide anymore."
        },
        {
          "es": "Kamohoaliʻi, su hermano tiburón, no quería dejarla ir sola.",
          "en": "Kamohoaliʻi, her shark brother, did not want to let her go alone."
        },
        {
          "es": "Pero al final aceptó, de mala gana.",
          "en": "But in the end, he agreed, unwillingly."
        },
        {
          "es": "Pele bajó de la montaña, sola, para pelear con su hermana.",
          "en": "Pele went down the mountain, alone, to fight her sister."
        },
        {
          "es": "Desde Kahiki había huido. Esta vez no iba a huir más.",
          "en": "She had run all the way from Kahiki. This time, she would not run."
        }
