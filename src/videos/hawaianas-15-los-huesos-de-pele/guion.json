      "frases": [
        {
          "es": "Sus huesos quedaron tirados en la costa de Maui.",
          "en": "Her bones were left lying on the coast of Maui."
        },
        {
          "es": "Según Emerson y Westervelt, quedaron en Kahikinui, y los llaman Nā iwi o Pele: los huesos de Pele.",
          "en": "Emerson and Westervelt say they lie at Kahikinui, and are called Nā iwi o Pele: the bones of Pele."
        },
        {
          "es": "Otra tradición los pone en Hāna, en una colina roja junto al cerro Kaʻuiki: Ka iwi o Pele.",
          "en": "Another tradition puts them at Hāna, in a red hill beside Kaʻuiki Head: Ka iwi o Pele."
        },
        {
          "es": "Son rocas de lava rotas, oscuras, junto al mar.",
          "en": "They are broken, dark rocks of lava, beside the sea."
        }
