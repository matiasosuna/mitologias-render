      "frases": [
        {
          "es": "Nāmaka se fue feliz. Estaba segura de que su enemiga había muerto.",
          "en": "Nāmaka left happy. She was sure her enemy was dead."
        },
        {
          "es": "La familia de Pele lloraba. Kamohoaliʻi estaba deshecho.",
          "en": "Pele's family wept. Kamohoaliʻi was heartbroken."
        },
        {
          "es": "¿Tú la habrías dejado pelear sola, si fueras su hermano?",
          "en": "If you were her brother, would you have let her fight alone?"
        },
        {
          "es": "Pero entonces Kamohoaliʻi miró hacia el sur, más allá del mar.",
          "en": "But then Kamohoaliʻi looked south, across the sea."
        }
      ],
