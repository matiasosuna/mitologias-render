      "frases": [
        {
          "es": "La pelea fue terrible. El fuego contra el mar.",
          "en": "The battle was terrible. Fire against sea."
        },
        {
          "es": "Pele lanzaba lava, y el agua hervía y se volvía vapor.",
          "en": "Pele threw lava, and the water boiled into steam."
        },
        {
          "es": "Nāmaka lanzaba olas enormes, y la lava se volvía piedra negra.",
          "en": "Nāmaka threw huge waves, and the lava turned to black stone."
        },
        {
          "es": "El dragón Haui ayudaba a Nāmaka. Y poco a poco, el mar empezó a ganar.",
          "en": "The dragon Haui helped Nāmaka. And little by little, the sea began to win."
        },
        {
          "es": "Al final, Nāmaka destrozó el cuerpo de Pele.",
          "en": "In the end, Nāmaka tore Pele's body apart."
        }
      ],
