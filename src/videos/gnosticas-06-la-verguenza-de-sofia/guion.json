      "rotulos": [
        {
          "en": 1.3,
          "texto": {
            "es": "\"NO COMO DIJO MOISÉS\"",
            "en": "\"NOT AS MOSES SAID\""
          },
          "x": 960,
          "y": 220,
          "hasta": 2.8
        }
      ],
      "frases": [
        {
          "en": "And John said, \"Lord, what does it mean, that she moved to and fro?\"",
          "es": "Y Juan dijo: \"Señor, ¿qué quiere decir que ella iba y venía?\""
        },
        {
          "en": "The Savior smiled and said, \"Do not think it is as Moses said, over the waters.\"",
          "es": "El Salvador sonrió y dijo: \"No pienses que es como dijo Moisés, sobre las aguas\"."
        },
        {
          "en": "For the book of Moses says the spirit moved over the face of the waters.",
          "es": "Porque el libro de Moisés dice que el espíritu se movía sobre la faz de las aguas."
        },
        {
          "en": "\"No,\" the Savior said. \"It was like this.\"",
          "es": "\"No\", dijo el Salvador. \"Fue así\"."
        }
      ]
