          "y": 200
        }
      ],
      "frases": [
        {
          "en": "Then a voice came down from the high aeon of heaven.",
          "es": "Entonces una voz bajó desde el alto eón del cielo."
        },
        {
          "en": "It said, \"Man exists, and the Son of Man.\"",
          "es": "Dijo: \"Existe el Humano, y el Hijo del Humano\"."
        },
        {
          "en": "The first ruler, Yaldabaoth, heard the voice.",
          "es": "El primer gobernante, Yaldabaoth, escuchó la voz."
        },
        {
          "en": "He thought the voice had come from his mother.",
          "es": "Pensó que la voz había venido de su madre."
        },
        {
          "en": "For he did not know where it came from.",
          "es": "Porque no sabía de dónde venía."
        }
      ]
