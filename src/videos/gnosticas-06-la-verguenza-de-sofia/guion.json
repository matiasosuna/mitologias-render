      ],
      "frases": [
        {
          "en": "Yaldabaoth said, \"I am a jealous God.\" And by saying it, he showed that another God exists.",
          "es": "Yaldabaoth dijo: \"Yo soy un Dios celoso\". Y al decirlo, mostró que existe otro Dios."
        },
        {
          "en": "Now the Savior told John what happened to his mother, Sophia.",
          "es": "Ahora el Salvador le contó a Juan lo que le pasó a su madre, Sofía."
        },
        {
          "en": "For she had brought forth Yaldabaoth alone, without her partner.",
          "es": "Porque ella había dado a luz a Yaldabaoth sola, sin su pareja."
        },
        {
          "en": "And John listened, so that he could write it down.",
          "es": "Y Juan escuchó, para poder escribirlo."
        }
      ]
    },
