          "hasta": 2
        },
        {
          "en": 3,
          "texto": {
            "es": "EL DESEO ES SU SEMILLA",
            "en": "DESIRE IS ITS SEED"
          },
          "x": 960,
          "y": 180
        }
      ],
      "frases": [
        {
          "en": "\"Its root is bitter, and its branches are death.\"",
          "es": "\"Su raíz es amarga, y sus ramas son muerte\"."
        },
        {
          "en": "\"Its shade is hatred, and deception lives in its leaves.\"",
          "es": "\"Su sombra es odio, y el engaño vive en sus hojas\"."
        },
        {
          "en": "\"Its blossom is the ointment of wickedness.\"",
          "es": "\"Su flor es el ungüento de la maldad\"."
        },
        {
          "en": "\"Its fruit is death, and desire is its seed.\"",
          "es": "\"Su fruta es la muerte, y el deseo es su semilla\"."
        },
        {
          "en": "\"And it sprouts in the darkness.\"",
          "es": "\"Y brota en la oscuridad\"."
        }
      ]
    },
