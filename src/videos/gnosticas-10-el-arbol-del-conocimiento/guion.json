        {
          "en": 0.4,
          "texto": {
            "es": "EL ÁRBOL DE SU VIDA",
            "en": "THE TREE OF THEIR LIFE"
          },
          "x": 1060,
          "y": 170
        }
      ],
      "frases": [
        {
          "en": "And they placed the tree of their life in the middle of paradise.",
          "es": "Y pusieron el árbol de su vida en medio del paraíso."
        },
        {
          "en": "The Savior said to John, \"I will teach you the secret of their life.\"",
          "es": "El Salvador le dijo a Juan: \"Te enseñaré el secreto de su vida\"."
        },
        {
          "en": "\"It is the plan they made together.\"",
          "es": "\"Es el plan que hicieron juntos\"."
        },
        {
          "en": "\"It is the likeness of their spirit.\"",
          "es": "\"Es la semejanza de su espíritu\"."
        }
      ]
    },
