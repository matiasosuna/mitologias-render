   "frases": [
    {
     "es": "Mucho antes, cuando Cronos hirió a Urano, unas gotas de su sangre cayeron sobre la tierra.",
     "en": "Long before, when Cronus wounded Uranus, drops of his blood fell upon the earth."
    },
    {
     "es": "De esa sangre, Gea hizo nacer a los Gigantes.",
     "en": "From that blood, Gaia raised the Giants."
    },
    {
     "es": "Eran enormes, de fuerza invencible y aspecto terrible, con cabelleras largas y barbas espesas.",
     "en": "They were huge, unbeatable in strength and terrible to look at, with long hair and thick beards."
    },
    {
     "es": "En algunas versiones, en lugar de piernas tenían colas de serpiente, cubiertas de escamas.",
     "en": "In some versions, instead of legs they had serpent tails, covered in scales."
    },
    {
     "es": "Nacieron en Flegra, una llanura humeante, y desde allí miraron hacia el Olimpo.",
     "en": "They were born on Phlegra, a smoking plain, and from there they looked up toward Olympus."
    }
   ],
