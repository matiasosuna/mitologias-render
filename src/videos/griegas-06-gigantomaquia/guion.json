   "frases": [
    {
     "es": "Todos los dioses entraron en batalla.",
     "en": "Every god joined the battle."
    },
    {
     "es": "Hefesto, el herrero, derramó hierro fundido sobre el Gigante Mimas.",
     "en": "Hephaestus, the smith, poured molten iron over the Giant Mimas."
    },
    {
     "es": "Dioniso derribó a Éurito con su tirso, la vara cubierta de hiedra.",
     "en": "Dionysus struck down Eurytus with his thyrsus, the ivy-covered staff."
    },
    {
     "es": "Hermes se puso el casco de Hades, que lo volvía invisible, y venció a Hipólito sin que lo viera llegar.",
     "en": "Hermes put on the helmet of Hades, which made him invisible, and defeated Hippolytus unseen."
    },
    {
     "es": "Y Heracles, con sus flechas, remataba a cada Gigante que caía.",
     "en": "And Heracles, with his arrows, finished off each Giant who fell."
    },
    {
     "es": "Al final, el campo de Flegra quedó en silencio: los dioses habían ganado.",
     "en": "In the end, the plain of Phlegra fell silent: the gods had won."
    }
   ],
