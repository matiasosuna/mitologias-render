      "frases": [
        {
          "es": "Brahma tomó la forma de su cisne y voló hacia arriba, buscando la punta.",
          "en": "Brahma took the form of his swan and flew upward, looking for the top."
        },
        {
          "es": "Voló y voló, más allá de las nubes, más allá de las estrellas.",
          "en": "He flew and flew, past the clouds, past the stars."
        },
        {
          "es": "El pilar seguía subiendo, sin fin.",
          "en": "The pillar kept rising, with no end."
        },
        {
          "es": "Brahma, cansado, empezó a tener miedo de volver con las manos vacías.",
          "en": "Brahma grew tired, and he began to fear going back with empty hands."
        }
      ],
