      "frases": [
        {
          "es": "Entonces Hera hizo algo terrible. Tomó a su hijo y lo arrojó desde el Olimpo.",
          "en": "So Hera did something terrible. She picked up her son and threw him from Olympus."
        },
        {
          "es": "Hefesto cayó durante mucho tiempo, entre las nubes.",
          "en": "Hephaestus fell for a very long time, down through the clouds."
        },
        {
          "es": "Las nubes pasaban a toda velocidad, y el mar se acercaba cada vez más.",
          "en": "The clouds rushed past him, and the sea came closer and closer."
        },
        {
          "es": "Hera lo vio desaparecer y no hizo nada.",
          "en": "Hera watched him disappear, and she did nothing."
        }
