      "frases": [
        {
          "es": "Hathor significa 'la casa de Horus'. El rey era Horus en la tierra, y ella era su madre divina.",
          "en": "Hathor means 'House of Horus'. The king was Horus on earth, and she was his divine mother."
        },
        {
          "es": "La llamaban 'la Dorada'. Llevaba un sistro, un instrumento de sonajas, y un espejo.",
          "en": "They called her 'the Golden One'. She held a sistrum, a jingling rattle, and a mirror."
        },
        {
          "es": "Su templo de Dendera sigue en pie. Tiene columnas con su rostro de orejas de vaca.",
          "en": "Her temple at Dendera still stands. It has columns carved with her cow-eared face."
        },
        {
          "es": "En el desierto del Sinaí, los mineros la llamaban 'Señora de la turquesa'.",
          "en": "In the Sinai desert, miners called her 'Lady of Turquoise'."
        }
