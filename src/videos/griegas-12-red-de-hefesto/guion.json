      "camara": {
        "de": 0,
        "a": 250
      },
      "frases": [
        {
          "es": "Hefesto escuchó en silencio. El enojo le llenó el corazón, pero no gritó.",
          "en": "Hephaestus listened in silence. His heart filled with anger, but he did not shout."
        },
        {
          "es": "Fue a su fragua, puso en su lugar el gran yunque y se puso a trabajar.",
          "en": "He went to his forge, set up his great anvil, and began to work."
        },
        {
          "es": "Forjó cadenas tan finas como una tela de araña. Ni siquiera un dios podía verlas.",
          "en": "He forged chains as thin as a spider's web. Not even a god could see them."
        },
        {
          "es": "Y eran tan fuertes que nadie podía romperlas.",
          "en": "And they were so strong that no one could break them."
        },
        {
          "es": "Llevó la red a su dormitorio y la colgó alrededor de la cama, como una trampa escondida.",
          "en": "He carried the net to his bedroom and hung it all around the bed, like a hidden trap."
        }
      ],
