      "frases": [
        {
          "es": "Junto al río, Hermes frotó dos palos y encendió fuego.",
          "en": "By the river, Hermes rubbed two sticks together, and made fire."
        },
        {
          "es": "Los griegos decían que fue el primero en hacer fuego de esa manera.",
          "en": "The Greeks said he was the first one to make fire this way."
        },
        {
          "es": "Después ofreció dos de las vacas y las asó en el fuego.",
          "en": "Then he offered two of the cows, and roasted them over the fire."
        },
        {
          "es": "Cortó la carne en doce partes iguales, como un regalo para los dioses.",
          "en": "He cut the meat into twelve equal parts, like a gift for the gods."
        },
        {
          "es": "Olía delicioso. Hermes quería comer, pero no probó ni un bocado.",
          "en": "It smelled delicious. Hermes wanted to eat, but he did not take a single bite."
        }
      ],
