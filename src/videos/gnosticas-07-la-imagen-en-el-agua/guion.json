      "frases": [
        {
          "en": "Then the seven powers began to make him.",
          "es": "Entonces los siete poderes empezaron a hacerlo."
        },
        {
          "en": "The first, Goodness, made a soul of bone.",
          "es": "El primero, la Bondad, hizo un alma de hueso."
        },
        {
          "en": "The second, Forethought, made a soul of sinew, the cords that hold the body together.",
          "es": "El segundo, la Previsión, hizo un alma de tendón, las cuerdas que sostienen el cuerpo."
        },
        {
          "en": "The third, Divinity, made a soul of flesh.",
          "es": "El tercero, la Divinidad, hizo un alma de carne."
        },
        {
          "en": "The fourth, Lordship, made a soul of marrow, the soft part inside the bones.",
          "es": "El cuarto, el Señorío, hizo un alma de médula, la parte blanda dentro de los huesos."
        }
      ]
