      "frases": [
        {
          "es": "Ra llamó a sus mensajeros más veloces, los que corren como el viento.",
          "en": "Ra summoned his fastest messengers, the ones who run like the wind."
        },
        {
          "es": "«Vayan a Elefantina, en el extremo sur, y tráiganme ocre rojo, tanto como puedan cargar».",
          "en": "\"Go to Elephantine, far to the south, and bring me red ochre, as much as you can carry.\""
        },
        {
          "es": "En Heliópolis, el sumo sacerdote molió el ocre mientras las sirvientas trituraban cebada para hacer cerveza.",
          "en": "In Heliopolis the high priest ground the ochre while the servant women crushed barley to brew beer."
        },
        {
          "es": "Mezclaron el ocre con la cerveza hasta que quedó roja como la sangre humana.",
          "en": "They mixed the ochre into the beer until it was red as human blood."
        },
        {
          "es": "Fueron siete mil jarras.",
          "en": "Seven thousand jars of it."
        }
      ],
