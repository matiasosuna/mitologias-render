      "frases": [
        {
          "es": "Ptah era el dios de los artesanos: escultores, carpinteros y orfebres.",
          "en": "Ptah was the god of craftsmen: sculptors, carpenters, and goldsmiths."
        },
        {
          "es": "Su gran sacerdote tenía un título: 'El Mayor de los que dirigen a los artesanos'.",
          "en": "His high priest had a title: 'Greatest of the Directors of Craftsmen'."
        },
        {
          "es": "Los griegos lo compararon con Hefesto, su dios herrero.",
          "en": "The Greeks compared him to Hephaestus, their god of the forge."
        },
        {
          "es": "Para los egipcios, hacer una estatua era casi un acto sagrado.",
          "en": "For the Egyptians, making a statue was almost a sacred act."
        }
      ],
