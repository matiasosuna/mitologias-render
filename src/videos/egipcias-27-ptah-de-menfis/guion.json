      "frases": [
        {
          "es": "Ptah tenía una familia. Su esposa era Sekhmet, la leona del episodio anterior.",
          "en": "Ptah had a family. His wife was Sekhmet, the lioness from the last episode."
        },
        {
          "es": "Su hijo era Nefertem, el dios del loto azul, la flor de la que nació el sol.",
          "en": "His son was Nefertem, god of the blue lotus, the flower from which the sun was born."
        },
        {
          "es": "Juntos formaban la familia divina de Menfis.",
          "en": "Together they made the divine family of Memphis."
        }
